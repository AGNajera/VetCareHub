---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Mascota from "../assets/mascota.svg";

export const prerender = false;

// Quien ya entró no tiene nada que hacer aquí
if (Astro.locals.user) return Astro.redirect("/dashboard");
---

<Layout
  titulo="Sistema VetCare"
  descripcion="Acceso al sistema interno de VetCareHub."
>
  <div class="page">
    <Header />
    <!-- A la izquierda el formulario y a la derecha Canela en su cuarto: la pared menta y
         el piso son los de su ilustración -->
    <main id="contenido" class="acceso">
      <section class="lado-form">
        <form class="formulario" novalidate>
          <h1>Sistema VetCare</h1>
          <p class="intro">
            Para el personal y los clientes de la clínica. Tu cuenta te la da la gerencia.
          </p>

          <label for="email">Correo</label>
          <input
            id="email"
            type="email"
            name="email"
            autocomplete="username"
            placeholder="apellido.nombre@vetcarehub.mx"
            aria-describedby="error-acceso"
            required
          />

          <label for="password">Contraseña</label>
          <div class="campo-password">
            <input
              id="password"
              type="password"
              name="password"
              autocomplete="current-password"
              aria-describedby="error-acceso"
              required
            />
            <button
              type="button"
              class="ver"
              aria-label="Mostrar contraseña"
              aria-pressed="false"
              aria-controls="password"
            >
              <!-- Íconos eye y eye-off de Tabler; el CSS muestra uno según aria-pressed -->
              <svg class="ojo" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M10 12a2 2 0 1 0 4 0a2 2 0 0 0 -4 0"></path>
                <path
                  d="M21 12c-2.4 4 -5.4 6 -9 6c-3.6 0 -6.6 -2 -9 -6c2.4 -4 5.4 -6 9 -6c3.6 0 6.6 2 9 6"
                ></path>
              </svg>
              <svg class="ojo-tachado" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M10.585 10.587a2 2 0 0 0 2.829 2.828"></path>
                <path
                  d="M16.681 16.673a8.717 8.717 0 0 1 -4.681 1.327c-3.6 0 -6.6 -2 -9 -6c1.272 -2.12 2.712 -3.678 4.32 -4.674m2.86 -1.146a9.055 9.055 0 0 1 1.82 -.18c3.6 0 6.6 2 9 6c-.666 1.11 -1.379 2.067 -2.138 2.87"
                ></path>
                <path d="M3 3l18 18"></path>
              </svg>
            </button>
          </div>

          <p id="error-acceso" class="error" role="alert"></p>

          <button type="submit" class="entrar">Entrar</button>
        </form>
      </section>

      <div class="lado-canela">
        <div class="cuarto">
          <Mascota class="canela" aria-hidden="true" />
        </div>
      </div>
    </main>
  </div>
</Layout>

<script>
  import { authClient } from "../lib/auth-client";

  const form = document.querySelector<HTMLFormElement>(".formulario");
  const error = form?.querySelector<HTMLElement>(".error");
  const entrar = form?.querySelector<HTMLButtonElement>(".entrar");
  const password = form?.querySelector<HTMLInputElement>("#password");
  const ver = form?.querySelector<HTMLButtonElement>(".ver");
  const canela = document.querySelector<SVGElement>(".canela");
  const campos = form?.querySelectorAll<HTMLInputElement>("#email, #password");

  // Con el error a la vista los dos campos se marcan como inválidos para el lector de
  // pantalla: el mensaje no dice cuál de los dos estaba mal
  const marcarInvalidos = (invalidos: boolean) =>
    campos?.forEach((campo) =>
      invalidos
        ? campo.setAttribute("aria-invalid", "true")
        : campo.removeAttribute("aria-invalid"),
    );

  const mostrarPassword = (mostrar: boolean) => {
    if (!password || !ver) return;
    password.type = mostrar ? "text" : "password";
    ver.setAttribute("aria-pressed", String(mostrar));
    ver.setAttribute(
      "aria-label",
      mostrar ? "Ocultar contraseña" : "Mostrar contraseña",
    );
  };

  ver?.addEventListener("click", () => {
    mostrarPassword(password?.type === "password");
    // El foco regresa al campo para seguir escribiendo donde se quedó
    password?.focus();
  });

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!form.reportValidity() || !error || !entrar) return;

    const datos = new FormData(form);
    // Se vuelve a ocultar para que el navegador no la guarde ni la deje a la vista
    mostrarPassword(false);
    error.textContent = "";
    marcarInvalidos(false);
    entrar.disabled = true;
    entrar.textContent = "Entrando…";
    // Canela mueve la cola mientras se revisa la cuenta
    canela?.classList.add("esperando");

    const { error: fallo } = await authClient.signIn.email({
      email: String(datos.get("email")),
      password: String(datos.get("password")),
    });

    if (!fallo) {
      location.assign("/dashboard");
      return;
    }

    // El mismo mensaje si el correo no existe o la contraseña está mal, para no revelar
    // qué correos tienen cuenta
    error.textContent =
      fallo.status === 429
        ? "Demasiados intentos. Espera un minuto y vuelve a intentarlo."
        : "El correo o la contraseña no son correctos.";
    marcarInvalidos(fallo.status !== 429);
    canela?.classList.remove("esperando");
    entrar.disabled = false;
    entrar.textContent = "Entrar";
  });
</script>

<style>
  .page {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    /* Mismo fondo que el header, para que la página se vea de una pieza */
    background-color: var(--color-surface);
    color: var(--color-primary);
    font-family: var(--font-body);
  }

  /* Dos mitades separadas por la misma línea marina del header */
  .acceso {
    /* Colores de la pared y el piso de mascota.svg */
    --piso: #c4e2d6;
    --zoclo: #a9d3c3;

    display: grid;
    flex: 1;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }

  .lado-form {
    display: grid;
    place-items: center;
    padding: 48px clamp(16px, 5vw, 64px);
  }

  .formulario {
    display: flex;
    flex-direction: column;
    width: min(100%, 400px);
  }

  .lado-canela {
    display: flex;
    border-left: var(--border);
  }

  /* El cuarto de Canela llena toda la mitad derecha */
  .cuarto {
    --canela: clamp(260px, 36vw, 520px);
    --alto-piso: clamp(100px, 18vh, 170px);

    display: flex;
    flex: 1;
    justify-content: center;
    align-items: flex-end;
    min-height: 360px;
    overflow: hidden;
    background: linear-gradient(
      to top,
      var(--piso) calc(var(--alto-piso) - 8px),
      var(--zoclo) 0 var(--alto-piso),
      var(--color-mint) 0
    );
  }

  .canela {
    flex-shrink: 0;
    width: var(--canela);
    height: auto;
    /* En la ilustración (580 de alto) el piso empieza 162 arriba de la orilla de abajo;
       se baja lo necesario para que sus patas queden sobre este piso */
    margin-bottom: calc(var(--alto-piso) - var(--canela) * 162 / 580);

    /* Sin la pared ni el piso de la ilustración: los pone el cuarto */
    :global(rect:nth-of-type(-n + 3)) {
      display: none;
    }

    /* La cola es el primer path; gira desde donde sale del cuerpo */
    :global(path:first-of-type) {
      transform-box: fill-box;
      transform-origin: left bottom;
    }
  }

  .canela.esperando :global(path:first-of-type) {
    animation: menear 0.45s ease-in-out infinite;
  }

  h1 {
    margin: 0;
    font-family: var(--font-bold);
    font-size: 1.9rem;
    line-height: 1.15;
  }

  .intro {
    margin: 8px 0 24px;
    line-height: 1.5;
  }

  label {
    margin-bottom: 6px;
    font-family: var(--font-bold);
    font-size: 1.05rem;
  }

  input,
  .campo-password {
    margin-bottom: 18px;
  }

  input {
    width: 100%;
    padding: 12px 14px;
    border: var(--border);
    border-radius: 8px;
    background-color: var(--color-white);
    color: var(--color-primary);
    font-family: var(--font-body);
    /* 16px o más para que Safari en iPhone no haga zoom al escribir */
    font-size: 1.05rem;

    /* 65% para que llegue a 4.5:1 sobre blanco */
    &::placeholder {
      color: color-mix(in oklch, var(--color-primary) 65%, white);
    }

    &:focus-visible {
      outline: var(--focus-ring);
      outline-offset: 2px;
    }
  }

  /* El botón del ojo va dentro del campo, del lado derecho */
  .campo-password {
    position: relative;

    input {
      margin-bottom: 0;
      padding-right: 52px;
    }
  }

  .ver {
    position: absolute;
    top: 50%;
    right: 6px;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: none;
    border-radius: 6px;
    background: none;
    color: var(--color-primary);
    cursor: pointer;
    translate: 0 -50%;

    &:hover {
      background-color: var(--color-mint);
    }

    &:focus-visible {
      outline: var(--focus-ring);
      outline-offset: 0;
    }

    svg {
      width: 22px;
      height: 22px;
      fill: none;
      stroke: currentColor;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .ojo-tachado {
      display: none;
    }

    &[aria-pressed="true"] {
      .ojo {
        display: none;
      }

      .ojo-tachado {
        display: block;
      }
    }
  }

  .error {
    margin: -4px 0 18px;
    color: #b42318;
    line-height: 1.4;

    &:empty {
      display: none;
    }
  }

  .entrar {
    padding: 14px;
    border: none;
    border-radius: 8px;
    background-color: var(--color-primary);
    color: var(--color-white);
    font-family: var(--font-bold);
    font-size: 1.15rem;
    cursor: pointer;

    &:hover:not(:disabled) {
      text-decoration: underline;
    }

    &:focus-visible {
      outline: var(--focus-ring);
      outline-offset: 3px;
    }

    &:disabled {
      opacity: 0.75;
      cursor: progress;
    }
  }

  /* En celular no caben dos mitades: toda la página es el cuarto de Canela, ella se
     asoma por detrás del formulario y el formulario se para en el piso como mostrador.
     display: contents quita las cajas de las mitades para acomodar a los dos juntos */
  @media (max-width: 820px) {
    .acceso {
      --canela: min(68vw, 280px);

      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-end;
      padding: 24px 16px 48px;
      background: linear-gradient(
        to top,
        var(--piso) 88px,
        var(--zoclo) 0 96px,
        var(--color-mint) 0
      );
      /* Para que la sombra del mostrador (z-index -1) quede sobre el piso */
      isolation: isolate;
    }

    .lado-form,
    .lado-canela,
    .cuarto {
      display: contents;
    }

    .canela {
      order: -1;
      /* El mostrador le tapa de la panza para abajo */
      margin-bottom: calc(var(--canela) * -0.3);
    }

    .formulario {
      position: relative;
      padding: 26px 20px 22px;
      border: var(--border);
      border-radius: 14px;
      background-color: var(--color-white);

      /* Su sombra en el piso, igual que la de Canela */
      &::after {
        content: "";
        position: absolute;
        left: 8%;
        right: 8%;
        bottom: -14px;
        z-index: -1;
        height: 24px;
        border-radius: 50%;
        background-color: var(--zoclo);
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .canela.esperando :global(path:first-of-type) {
      animation: none;
    }
  }
</style>

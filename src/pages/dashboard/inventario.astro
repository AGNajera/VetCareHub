---
import Sistema from "../../layouts/Sistema.astro";
import Icono from "../../components/sistema/Icono.astro";
import { pool } from "../../lib/db";
import { acciones } from "../../lib/permisos";
import { fecha, normalizar, numero, pesos } from "../../lib/formato";

export const prerender = false;

const user = Astro.locals.user!;
const permisos = acciones(user.role, "inventario");
const puedeVer = permisos.includes("ver");
const puedeCrear = permisos.includes("crear");
const puedeEditar = permisos.includes("editar");

type Producto = {
  id: string;
  nombre: string;
  categoria: string;
  unidad: string;
  cantidad: number;
  stock_minimo: number;
  precio: string;
  caducidad: Date | null;
  activo: boolean;
  proveedor_id: string | null;
  proveedor: string | null;
};

// Los deshabilitados van al final; numeric llega como texto desde pg
const [productos, proveedores] = puedeVer
  ? await Promise.all([
      pool
        .query<Producto>(
          `select i.id, i.nombre, i.categoria, i.unidad, i.cantidad, i.stock_minimo, i.precio,
                  i.caducidad, i.activo, i.proveedor_id, p.nombre as proveedor
           from inventario i
           left join proveedores p on p.id = i.proveedor_id
           order by i.activo desc, i.categoria, i.nombre`,
        )
        .then(({ rows }) => rows),
      puedeCrear
        ? pool
            .query<{ id: string; nombre: string }>("select id, nombre from proveedores order by nombre")
            .then(({ rows }) => rows)
        : [],
    ])
  : [[], []];

const categorias = ["medicamento", "vacuna", "material", "alimento", "higiene"];
---

<Sistema titulo="Inventario">
  {
    puedeVer && productos.length > 0 && (
      <label slot="acciones" class="buscador campo">
        <span class="visualmente-oculto">Buscar en el inventario</span>
        <Icono nombre="buscar" />
        <input id="buscar" type="search" placeholder="Buscar producto o proveedor" autocomplete="off" />
      </label>
    )
  }
  {
    puedeCrear && (
      <button slot="acciones" type="button" class="boton-nuevo" data-abrir="nuevo-producto">
        <Icono nombre="mas" />
        Nuevo producto
      </button>
    )
  }

  {
    !puedeVer ? (
      <p class="vacio">Tu rol no tiene acceso al inventario.</p>
    ) : productos.length === 0 ? (
      <p class="vacio">
        Todavía no hay productos.
        {puedeCrear && " Agrega el primero con Nuevo producto."}
      </p>
    ) : (
      <>
        <div class="marco-tabla" tabindex="0" role="region" aria-label="Productos del inventario">
          <table id="tabla">
            <thead>
              <tr>
                <th class="fija-inicio">Producto</th>
                <th>Categoría</th>
                <th class="numero">Existencias</th>
                <th class="numero">Mínimo</th>
                <th class="numero">Precio</th>
                <th>Caducidad</th>
                <th>Proveedor</th>
                <th>Estado</th>
                {puedeEditar && <th class="fija-fin">Acciones</th>}
              </tr>
            </thead>
            <tbody>
              {productos.map((p) => {
                const agotandose = p.cantidad <= p.stock_minimo;
                return (
                  <tr
                    class:list={{ inactivo: !p.activo }}
                    data-id={p.id}
                    data-nombre={p.nombre}
                    data-unidad={p.unidad}
                    data-minimo={p.stock_minimo}
                    data-buscar={normalizar(`${p.nombre} ${p.categoria} ${p.proveedor ?? ""}`)}
                  >
                    <td class="fija-inicio producto">{p.nombre}</td>
                    <td class="secundario categoria">{p.categoria}</td>
                    <td class="numero existencias">
                      <span class:list={["cantidad", { bajo: agotandose && p.activo }]}>
                        {numero.format(p.cantidad)}
                      </span>{" "}
                      <span class="secundario">{p.unidad}</span>
                    </td>
                    <td class="numero secundario">{numero.format(p.stock_minimo)}</td>
                    <td class="numero">{pesos.format(Number(p.precio))}</td>
                    <td class="secundario">{p.caducidad ? fecha.format(p.caducidad) : "—"}</td>
                    <td>
                      {p.proveedor ? (
                        <a class="proveedor" href={`/dashboard/proveedores#proveedor-${p.proveedor_id}`}>
                          {p.proveedor}
                        </a>
                      ) : (
                        <span class="secundario">Sin proveedor</span>
                      )}
                    </td>
                    <td class="estado">
                      {!p.activo ? (
                        <span class="etiqueta apagada">Deshabilitado</span>
                      ) : (
                        <span class:list={["etiqueta", { alerta: agotandose }]}>
                          {agotandose ? "Por agotarse" : "Suficiente"}
                        </span>
                      )}
                    </td>
                    {puedeEditar && (
                      <td class="fija-fin">
                        <div class="acciones">
                          {p.activo ? (
                            <>
                              <div class="contador" role="group" aria-label={`Existencias de ${p.nombre}`}>
                                <button
                                  type="button"
                                  class="boton-icono"
                                  data-cambio="1"
                                  aria-label={`Sumar 1 ${p.unidad} de ${p.nombre}`}
                                  title="Sumar uno"
                                >
                                  <Icono nombre="mas" />
                                </button>
                                {/* En celular la columna de existencias queda fuera de vista */}
                                <span class:list={["contador-valor", { bajo: agotandose }]} aria-hidden="true">
                                  {numero.format(p.cantidad)}
                                </span>
                                <button
                                  type="button"
                                  class="boton-icono"
                                  data-cambio="-1"
                                  aria-label={`Restar 1 ${p.unidad} de ${p.nombre}`}
                                  title="Restar uno"
                                  disabled={p.cantidad === 0}
                                >
                                  <Icono nombre="menos" />
                                </button>
                              </div>
                              <button
                                type="button"
                                class="boton-icono peligro"
                                data-activo="false"
                                aria-label={`Deshabilitar ${p.nombre}`}
                                title="Deshabilitar"
                              >
                                <Icono nombre="deshabilitar" />
                              </button>
                            </>
                          ) : (
                            <button type="button" class="boton habilitar" data-activo="true">
                              <Icono nombre="habilitar" />
                              Habilitar
                            </button>
                          )}
                        </div>
                      </td>
                    )}
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
        <p class="vacio sin-resultados" hidden />
      </>
    )
  }

  {
    puedeCrear && (
      <dialog id="nuevo-producto" class="dialogo" aria-labelledby="titulo-nuevo">
        <form novalidate>
          <h2 id="titulo-nuevo">Nuevo producto</h2>
          <div class="campos">
            <div class="campo ancho">
              <label for="p-nombre">Nombre</label>
              <input id="p-nombre" name="nombre" required />
            </div>
            <div class="campo">
              <label for="p-categoria">Categoría</label>
              <select id="p-categoria" name="categoria" required>
                <option value="">Elige una</option>
                {categorias.map((c) => (
                  <option value={c}>{c[0].toUpperCase() + c.slice(1)}</option>
                ))}
              </select>
            </div>
            <div class="campo">
              <label for="p-unidad">Unidad</label>
              <input id="p-unidad" name="unidad" required value="pieza" placeholder="pieza, caja, frasco…" />
            </div>
            <div class="campo">
              <label for="p-cantidad">Existencias</label>
              <input id="p-cantidad" name="cantidad" type="number" min="0" step="1" value="0" required />
            </div>
            <div class="campo">
              <label for="p-minimo">Mínimo</label>
              <input id="p-minimo" name="stock_minimo" type="number" min="0" step="1" value="0" required />
            </div>
            <div class="campo">
              <label for="p-precio">Precio (MXN)</label>
              <input id="p-precio" name="precio" type="number" min="0" step="0.01" value="0" required />
            </div>
            <div class="campo">
              <label for="p-caducidad">Caducidad</label>
              <input id="p-caducidad" name="caducidad" type="date" />
            </div>
            <div class="campo ancho">
              <label for="p-proveedor">Proveedor</label>
              <select id="p-proveedor" name="proveedor_id">
                <option value="">Sin proveedor</option>
                {proveedores.map(({ id, nombre }) => (
                  <option value={id}>{nombre}</option>
                ))}
              </select>
            </div>
          </div>
          <p class="error-form" role="alert" />
          <div class="dialogo-botones">
            <button type="submit" class="boton" formmethod="dialog" formnovalidate value="cancelar">
              Cancelar
            </button>
            <button type="submit" class="boton principal">
              Agregar producto
            </button>
          </div>
        </form>
      </dialog>
    )
  }
</Sistema>

<script>
  import { actions } from "astro:actions";
  import {
    activarBuscador,
    enviarConAccion,
    mensajeDeError,
    mostrarError,
  } from "../../scripts/sistema";

  const tabla = document.querySelector<HTMLTableElement>("#tabla");
  const aviso = document.querySelector<HTMLElement>("#aviso");
  const formato = new Intl.NumberFormat("es-MX");

  activarBuscador(document.querySelector("#buscar"), tabla);

  // Nuevo producto
  const dialogo = document.querySelector<HTMLDialogElement>("#nuevo-producto");
  document
    .querySelector("[data-abrir=nuevo-producto]")
    ?.addEventListener("click", () => dialogo?.showModal());
  enviarConAccion(dialogo, (datos) => actions.inventario.crear(datos));

  tabla?.addEventListener("click", async (event) => {
    const boton = (event.target as Element).closest<HTMLButtonElement>("button");
    const fila = boton?.closest<HTMLTableRowElement>("tr");
    if (!boton || !fila?.dataset.id || !aviso) return;
    const { id, nombre, unidad } = fila.dataset;

    // + y −: se cambia el número en la fila sin recargar
    if (boton.dataset.cambio) {
      const botones = fila.querySelectorAll<HTMLButtonElement>("[data-cambio]");
      botones.forEach((b) => (b.disabled = true));
      const { data, error } = await actions.inventario.ajustar({
        id,
        cambio: Number(boton.dataset.cambio) as 1 | -1,
      });
      botones.forEach((b) => (b.disabled = false));

      if (error) {
        mostrarError(mensajeDeError(error));
        return;
      }

      const agotandose = data.cantidad <= data.stock_minimo;
      for (const cantidad of fila.querySelectorAll<HTMLElement>(".cantidad, .contador-valor")) {
        cantidad.textContent = formato.format(data.cantidad);
        cantidad.classList.toggle("bajo", agotandose);
      }
      const etiqueta = fila.querySelector<HTMLElement>(".estado .etiqueta")!;
      etiqueta.classList.toggle("alerta", agotandose);
      etiqueta.textContent = agotandose ? "Por agotarse" : "Suficiente";
      fila.querySelector<HTMLButtonElement>("[data-cambio='-1']")!.disabled = data.cantidad === 0;

      // Un destello en la celda para que se note qué cambió
      const celda = fila.querySelector<HTMLElement>(".existencias")!;
      celda.classList.remove("cambio");
      void celda.offsetWidth;
      celda.classList.add("cambio");

      aviso.textContent = `${nombre}: ${data.cantidad} ${unidad}${agotandose ? ", por agotarse" : ""}`;
      return;
    }

    // Deshabilitar o habilitar: la fila cambia de lugar, así que se recarga
    if (boton.dataset.activo) {
      boton.disabled = true;
      const { error } = await actions.inventario.activar({
        id,
        activo: boton.dataset.activo === "true",
      });
      if (error) {
        boton.disabled = false;
        mostrarError(mensajeDeError(error));
        return;
      }
      location.reload();
    }
  });
</script>

<style>
  .categoria {
    text-transform: capitalize;
  }

  .producto {
    font-family: var(--font-bold);
  }

  .cantidad {
    display: inline-block;
    min-width: 2ch;
    font-family: var(--font-bold);
    font-size: 1.15rem;

    &.bajo {
      color: #8a3b0c;
    }
  }

  .existencias.cambio {
    animation: destello 700ms ease-out;
  }

  .proveedor {
    color: var(--color-primary);
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;

    &:hover {
      color: var(--color-accent-texto);
    }

    &:focus-visible {
      outline: var(--focus-ring);
      outline-offset: 2px;
    }
  }

  .acciones {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  /* + y − pegados en una sola pieza, separados de Deshabilitar */
  .contador {
    display: inline-flex;
    padding: 2px;
    border: var(--border);
    border-radius: 10px;
    background-color: var(--color-white);

    :global(.boton-icono) {
      width: 34px;
      height: 34px;
    }

    :global(.boton-icono:hover:not(:disabled)) {
      border-color: transparent;
      background-color: var(--color-mint);
    }
  }

  .contador-valor {
    display: none;
    align-self: center;
    min-width: 3ch;
    font-family: var(--font-bold);
    font-variant-numeric: tabular-nums;
    text-align: center;

    &.bajo {
      color: #8a3b0c;
    }
  }

  @media (max-width: 820px) {
    .contador-valor {
      display: block;
    }
  }

  .habilitar {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    font-size: 0.95rem;

    :global(.icono) {
      width: 18px;
      height: 18px;
    }
  }

  /* Los deshabilitados se quedan a la vista pero apagados, sin bajar de 4.5:1 */
  tr.inactivo td:not(.fija-fin) {
    color: color-mix(in oklch, var(--color-primary) 65%, white);
  }

  tr.inactivo .producto {
    text-decoration: line-through;
  }

  .etiqueta.apagada {
    background-color: color-mix(in oklch, var(--color-primary) 10%, white);
  }

  @keyframes destello {
    from {
      background-color: var(--color-mint);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .existencias.cambio {
      animation: none;
    }
  }
</style>

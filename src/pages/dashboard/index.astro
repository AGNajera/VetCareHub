---
import Sistema from "../../layouts/Sistema.astro";
import Icono, { type NombreIcono } from "../../components/sistema/Icono.astro";
import { pool } from "../../lib/db";
import { numero } from "../../lib/formato";

export const prerender = false;

const user = Astro.locals.user!;

// Los deshabilitados no cuentan: ya no se usan en la clínica
const { rows } = await pool.query<{ usuarios: number; productos: number; agotandose: number }>(
  `select (select count(*) from "user")::int as usuarios,
          count(*)::int as productos,
          count(*) filter (where cantidad <= stock_minimo)::int as agotandose
   from inventario
   where activo`,
);
const { usuarios, productos, agotandose } = rows[0];

// La de productos lleva al inventario; las demás todavía no tienen página
const tarjetas: { titulo: string; valor: string; nota: string; icono: NombreIcono; href?: string }[] = [
  {
    titulo: "Usuarios",
    valor: numero.format(usuarios),
    nota: "Cuentas del personal",
    icono: "usuarios",
  },
  {
    titulo: "Productos",
    valor: numero.format(productos),
    nota: agotandose ? `${agotandose} por agotarse` : "Todo con existencias",
    icono: "inventario",
    href: "/dashboard/inventario",
  },
  {
    titulo: "Clientes",
    valor: "—",
    nota: "Aún sin registro",
    icono: "clientes",
  },
];
---

<Sistema titulo="Inicio" encabezado={`Hola, ${user.name.split(" ")[0]}`}>
  <ul class="tarjetas">
    {
      tarjetas.map(({ titulo, valor, nota, icono, href }) => {
        const Etiqueta = href ? "a" : "div";
        return (
          <li>
            <Etiqueta class:list={["tarjeta", { enlace: href }]} href={href}>
              <span class="tarjeta-icono">
                <Icono nombre={icono} />
              </span>
              <h2>{titulo}</h2>
              <p class="valor">{valor}</p>
              <p class="nota">{nota}</p>
            </Etiqueta>
          </li>
        );
      })
    }
  </ul>
</Sistema>

<style>
  .tarjetas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tarjeta {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: start;
    height: 100%;
    padding: 20px 22px;
    border: var(--border);
    border-radius: 14px;
    background-color: var(--color-surface);
    color: var(--color-primary);
    text-decoration: none;

    h2 {
      grid-row: 1;
      margin: 0;
      font-family: var(--font-bold);
      font-size: 1.1rem;
    }

    p {
      grid-column: 1 / -1;
      margin: 0;
    }
  }

  /* La que lleva a otra página se ve igual que las demás */
  .tarjeta.enlace {
    &:focus-visible {
      outline: var(--focus-ring);
      outline-offset: 4px;
    }
  }

  .tarjeta-icono {
    display: grid;
    grid-row: 1;
    grid-column: 2;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background-color: var(--color-mint);
    color: var(--color-accent);
  }

  .valor {
    margin-top: 4px;
    font-family: var(--font-bold);
    font-size: 2.4rem;
    line-height: 1.1;
  }

  .nota {
    color: var(--color-accent-texto);
  }
</style>

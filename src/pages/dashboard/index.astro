---
import Sistema from "../../layouts/Sistema.astro";
import BienvenidaMascota from "../../components/sistema/BienvenidaMascota.astro";
import Icono, { type NombreIcono } from "../../components/sistema/Icono.astro";
import { pool } from "../../lib/db";
import { preciosServicio, servicios, type Servicio } from "../../lib/citas";
import { fecha, numero, pesos } from "../../lib/formato";

export const prerender = false;

const user = Astro.locals.user!;

type Proxima = {
  id: string;
  mascota: string;
  cliente: string;
  fecha: string;
  hora: string;
  servicio: Servicio;
  estado: string;
};

// Los productos deshabilitados y las citas canceladas no cuentan
const [{ rows }, { rows: proximas }] = await Promise.all([
  pool.query<{
    personal: number;
    clientes: number;
    citas: number;
    citas_hoy: number;
    productos: number;
    agotandose: number;
  }>(
    `select (select count(*)::int from "user" where role <> 'cliente') as personal,
            (select count(*)::int from "user" where role = 'cliente') as clientes,
            (select count(*)::int from citas
             where estado in ('pendiente', 'confirmada')
               and fecha + hora > (now() at time zone 'America/Mexico_City')) as citas,
            (select count(*)::int from citas
             where estado in ('pendiente', 'confirmada')
               and fecha = (now() at time zone 'America/Mexico_City')::date) as citas_hoy,
            count(*)::int as productos,
            count(*) filter (where cantidad <= stock_minimo)::int as agotandose
     from inventario
     where activo`,
  ),
  pool.query<Proxima>(
    `select c.id, c.mascota, u.name as cliente, to_char(c.fecha, 'YYYY-MM-DD') as fecha,
            to_char(c.hora, 'HH24:MI') as hora, c.servicio, c.estado
     from citas c
     join "user" u on u.id = c.cliente_id
     where c.estado in ('pendiente', 'confirmada')
       and c.fecha + c.hora > (now() at time zone 'America/Mexico_City')
     order by c.fecha, c.hora
     limit 5`,
  ),
]);
const { personal, clientes, citas, citas_hoy, productos, agotandose } = rows[0];

const tarjetas: { titulo: string; valor: string; nota: string; icono: NombreIcono; href?: string }[] = [
  {
    titulo: "Citas próximas",
    valor: numero.format(citas),
    nota: citas_hoy ? `${citas_hoy} hoy` : "Ninguna hoy",
    icono: "citas",
    href: "/dashboard/citas",
  },
  {
    titulo: "Clientes",
    valor: numero.format(clientes),
    nota: clientes ? "Cuentas registradas" : "Aún sin registro",
    icono: "clientes",
    href: "/dashboard/clientes",
  },
  {
    titulo: "Productos",
    valor: numero.format(productos),
    nota: agotandose ? `${agotandose} por agotarse` : "Todo con existencias",
    icono: "inventario",
    href: "/dashboard/inventario",
  },
  {
    titulo: "Personal",
    valor: numero.format(personal),
    nota: "Cuentas de la clínica",
    icono: "usuarios",
  },
];
---

<Sistema titulo="Inicio" encabezado={`Hola, ${user.name.split(" ")[0]}`}>
  <BienvenidaMascota
    titulo="¡Buen día en la clínica!"
    texto="Aquí tienes el resumen de hoy: revisa las próximas citas, las cuentas de los clientes y las existencias del inventario."
  />

  <ul class="tarjetas">
    {
      tarjetas.map(({ titulo, valor, nota, icono, href }) => {
        const Etiqueta = href ? "a" : "div";
        return (
          <li>
            <Etiqueta class:list={["tarjeta", { enlace: href }]} href={href}>
              <span class="tarjeta-icono">
                <Icono nombre={icono} />
              </span>
              <h2>{titulo}</h2>
              <p class="valor">{valor}</p>
              <p class="nota">{nota}</p>
            </Etiqueta>
          </li>
        );
      })
    }
  </ul>

  {
    proximas.length > 0 && (
      <section class="bloque" aria-labelledby="titulo-proximas">
        <div class="bloque-encabezado">
          <h2 id="titulo-proximas">Próximas citas</h2>
          <a href="/dashboard/citas">Ver todas</a>
        </div>
        <div class="marco-tabla" tabindex="0" role="region" aria-label="Próximas citas">
          <table>
            <thead>
              <tr>
                <th>Fecha y hora</th>
                <th>Mascota</th>
                <th>Cliente</th>
                <th>Servicio</th>
                <th class="numero">Precio</th>
                <th>Estado</th>
              </tr>
            </thead>
            <tbody>
              {proximas.map((c) => (
                <tr>
                  <td>
                    {fecha.format(new Date(`${c.fecha}T00:00:00Z`))},{" "}
                    <strong class="hora">{c.hora}</strong>
                  </td>
                  <td class="nombre">{c.mascota}</td>
                  <td>{c.cliente}</td>
                  <td>{servicios[c.servicio]}</td>
                  <td class="numero">{pesos.format(preciosServicio[c.servicio])}</td>
                  <td>
                    <span class:list={["etiqueta", { alerta: c.estado === "pendiente" }]}>
                      {c.estado === "pendiente" ? "Pendiente" : "Confirmada"}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )
  }
</Sistema>

<style>
  .tarjetas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tarjeta {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: start;
    height: 100%;
    padding: 20px 22px;
    border: var(--border);
    border-radius: 14px;
    background-color: var(--color-surface);
    color: var(--color-primary);
    text-decoration: none;

    h2 {
      grid-row: 1;
      margin: 0;
      font-family: var(--font-bold);
      font-size: 1.1rem;
    }

    p {
      grid-column: 1 / -1;
      margin: 0;
    }
  }

  /* La que lleva a otra página se ve igual que las demás */
  .tarjeta.enlace {
    &:focus-visible {
      outline: var(--focus-ring);
      outline-offset: 4px;
    }
  }

  .tarjeta-icono {
    display: grid;
    grid-row: 1;
    grid-column: 2;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background-color: var(--color-mint);
    color: var(--color-accent);
  }

  .valor {
    margin-top: 4px;
    font-family: var(--font-bold);
    font-size: 2.4rem;
    line-height: 1.1;
  }

  .nota {
    color: var(--color-accent-texto);
  }

  .nombre,
  .hora {
    font-family: var(--font-bold);
  }
</style>

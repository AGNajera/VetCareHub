---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import { roles } from "../lib/permisos";

export const prerender = false;

const { user } = Astro.locals;
if (!user) return Astro.redirect("/login");

// Lo que su rol le deja hacer en cada sección (src/lib/permisos.ts)
const permisos = roles[user.role as keyof typeof roles]?.statements ?? {};
const secciones = [
  {
    titulo: "Inventario",
    descripcion: "Medicamentos, vacunas y material de la clínica.",
    acciones: permisos.inventario ?? [],
  },
  {
    titulo: "Proveedores",
    descripcion: "Laboratorios y distribuidores con los que trabajamos.",
    acciones: permisos.proveedores ?? [],
  },
];
---

<Layout titulo="Sistema" descripcion="Sistema interno de VetCareHub.">
  <div class="page">
    <Header />
    <main class="section">
      <div class="saludo">
        <div>
          <h1>Hola, {user.name.split(" ")[0]}</h1>
          <p>{user.puesto ?? user.email}</p>
        </div>
        <button type="button" class="salir">Cerrar sesión</button>
      </div>

      <ul class="secciones">
        {
          secciones.map(({ titulo, descripcion, acciones }) => (
            <li>
              <h2>{titulo}</h2>
              <p>{descripcion}</p>
              <p class="permisos">
                {acciones.length > 0
                  ? `Puedes ${new Intl.ListFormat("es").format(acciones)}.`
                  : "No tienes acceso."}
              </p>
              <span class="pronto">Próximamente</span>
            </li>
          ))
        }
      </ul>
    </main>
  </div>
</Layout>

<script>
  import { authClient } from "../lib/auth-client";

  const salir = document.querySelector<HTMLButtonElement>(".salir");

  salir?.addEventListener("click", async () => {
    salir.disabled = true;
    await authClient.signOut();
    location.assign("/");
  });
</script>

<style>
  .page {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    background-color: var(--color-bg);
    color: var(--color-primary);
    font-family: var(--font-body);
  }

  .saludo {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 32px;

    h1 {
      margin: 0 0 4px;
      font-family: var(--font-bold);
      font-size: 2rem;
    }

    p {
      margin: 0;
      font-size: 1.15rem;
    }
  }

  .salir {
    padding: 10px 18px;
    border: var(--border);
    border-radius: 8px;
    background: none;
    color: var(--color-primary);
    font-family: var(--font-bold);
    font-size: 1.05rem;
    cursor: pointer;

    &:hover {
      background-color: var(--color-primary);
      color: var(--color-white);
    }

    &:focus-visible {
      outline: var(--focus-ring);
      outline-offset: 3px;
    }
  }

  .secciones {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;

    li {
      display: flex;
      flex-direction: column;
      gap: 8px;
      padding: 24px;
      border: var(--border);
      border-radius: 14px;
      background-color: var(--color-surface);
    }

    h2 {
      margin: 0;
    }

    p {
      margin: 0;
      line-height: 1.5;
    }
  }

  .permisos {
    color: var(--color-accent);
  }

  .pronto {
    align-self: flex-start;
    margin-top: 8px;
    padding: 4px 12px;
    border-radius: 999px;
    background-color: var(--color-mint);
    font-size: 0.95rem;
  }
</style>

---
// Cartilla clínica y de fidelidad de dos hojas para el cliente (/cliente/historial).
// Portada azul marino con Canela (la mascota de VetCareHub), puntos con caducidad de 6 meses
// y descarga en PDF blanco y negro; a la derecha, filtro por mascota e historial scroleable.
import Mascota from "../../assets/mascota.svg";
import Icono from "./Icono.astro";
import {
  ahoraEnClinica,
  calcularPuntosVisitas,
  especies,
  estados,
  fechaCaducidadPuntos,
  MESES_CADUCIDAD_PUNTOS,
  nivelDePuntos,
  preciosServicio,
  puntosServicio,
  puntosVigentesEn,
  servicios,
} from "../../lib/citas";
import { fecha, numero, pesos } from "../../lib/formato";
import type { DatosCarnet } from "../../lib/pdf-carnet";

type Props = {
  carnet: DatosCarnet;
};

const { carnet } = Astro.props;
const folio = `VCH-${carnet.id.slice(0, 8).toUpperCase()}`;
const hoy = ahoraEnClinica().fecha;

const completadas = carnet.visitas.filter((v) => v.estado === "completada");
const resumenPuntos = calcularPuntosVisitas(carnet.visitas, hoy);
const nivel = nivelDePuntos(resumenPuntos.vigentes);

const mascotasConPuntos = carnet.mascotas.map((m) => {
  const pts = completadas
    .filter((v) => v.mascota_id === m.id && puntosVigentesEn(v.fecha, hoy))
    .reduce((acc, v) => acc + puntosServicio[v.servicio], 0);
  return { ...m, puntosVigentes: pts };
});
---

<article class="cartilla" aria-labelledby="cartilla-titular">
  <!-- Hoja izquierda: Portada con Canela, puntos y caducidad -->
  <aside class="portada">
    <div class="portada-arriba">
      <div class="portada-cabecera">
        <div class="marca-canela">
          <div class="canela-marco" aria-hidden="true">
            <Mascota class="canela-svg" />
          </div>
          <div>
            <span class="clinica" translate="no">VetCareHub</span>
            <span class="etiqueta-carnet">Carnet clínico</span>
          </div>
        </div>
        <span class="folio tabular" translate="no">#{folio}</span>
      </div>

      <div class="titular-bloque">
        <p class="portada-label">Titular del carnet</p>
        <h2 id="cartilla-titular" class="titular-nombre">{carnet.nombre}</h2>
        <p class="titular-meta" translate="no">{carnet.correo}</p>
        <p class="titular-meta">
          Tel. {carnet.telefono ?? "No registrado"} · Desde {fecha.format(new Date(carnet.alta))}
        </p>
      </div>

      <div class="caja-puntos">
        <div class="caja-puntos-top">
          <span class="portada-label">Puntos vigentes</span>
          <span class="pildora-nivel">{nivel.nombre}</span>
        </div>
        <p class="puntos-cifra tabular">
          {numero.format(resumenPuntos.vigentes)} <span>pts</span>
        </p>
        <div
          class="barra-progreso"
          role="progressbar"
          aria-label="Avance hacia el siguiente nivel del carnet"
          aria-valuenow={nivel.progreso}
          aria-valuemin={0}
          aria-valuemax={100}
        >
          <div class="barra-relleno" style={`width: ${nivel.progreso}%`}></div>
        </div>
        <p class="beneficio">{nivel.beneficio}</p>
        {
          nivel.siguiente && (
            <p class="siguiente tabular">
              Faltan {numero.format(nivel.faltan)} pts para llegar a {numero.format(nivel.siguiente)} pts.
            </p>
          )
        }
      </div>

      <div class="aviso-caducidad">
        <strong>Caducidad de {MESES_CADUCIDAD_PUNTOS} meses:</strong> cada visita completada suma el
        10% de su costo en puntos vigentes por {MESES_CADUCIDAD_PUNTOS} meses.
        {
          resumenPuntos.proximoVencimiento && (
            <div class="vencimiento-dato tabular">
              Próximo vencimiento:{" "}
              <strong>
                {numero.format(resumenPuntos.proximoVencimiento.puntos)} pts el{" "}
                {fecha.format(new Date(`${resumenPuntos.proximoVencimiento.fecha}T00:00:00Z`))}
              </strong>
              .
            </div>
          )
        }
        {
          resumenPuntos.vencidos > 0 && (
            <div class="vencidos-nota tabular">
              {numero.format(resumenPuntos.vencidos)} pts anteriores ya cumplieron{" "}
              {MESES_CADUCIDAD_PUNTOS} meses.
            </div>
          )
        }
      </div>
    </div>

    <a class="boton-pdf" href={`/api/carnet/${carnet.id}.pdf`} download>
      <Icono nombre="descargar" />
      Descargar carnet en PDF
    </a>
  </aside>

  <!-- Hoja derecha: Filtros por mascota + historial scroleable -->
  <section class="expediente" aria-label="Historial de visitas y puntos">
    <div class="expediente-barra" role="group" aria-label="Filtrar visitas por mascota">
      <button type="button" class="filtro-chip" data-filtro-mascota="todas" aria-pressed="true">
        Todas las mascotas ({numero.format(carnet.visitas.length)})
      </button>
      {
        mascotasConPuntos.map((m) => (
          <button
            type="button"
            class="filtro-chip"
            data-filtro-mascota={m.id}
            aria-pressed="false"
          >
            {m.nombre} · {especies[m.especie]} (+{numero.format(m.puntosVigentes)} pts)
          </button>
        ))
      }
    </div>

    <div class="lista-visitas" tabindex="0" role="region" aria-label="Listado de visitas">
      {
        carnet.visitas.length === 0 ? (
          <p class="vacio-lista">
            Todavía no hay visitas registradas. Agenda tu primera cita en{" "}
            <a href="/cliente/citas">Mis citas</a> para empezar a acumular puntos.
          </p>
        ) : (
          carnet.visitas.map((v) => {
            const pts = puntosServicio[v.servicio];
            const caduca = fechaCaducidadPuntos(v.fecha);
            const vigente = v.estado === "completada" ? puntosVigentesEn(v.fecha, hoy) : null;
            return (
              <div
                class:list={[
                  "tarjeta-visita",
                  { caducada: vigente === false, cancelada: v.estado === "cancelada" },
                ]}
                data-mascota-id={v.mascota_id}
              >
                <div class="visita-izq">
                  <div class="visita-cabecera">
                    <strong class="visita-servicio">{servicios[v.servicio]}</strong>
                    <span class="visita-mascota">{v.mascota}</span>
                  </div>
                  <p class="visita-meta tabular">
                    {fecha.format(new Date(`${v.fecha}T00:00:00Z`))} · {v.hora} h ·{" "}
                    {pesos.format(preciosServicio[v.servicio])} · {estados[v.estado]}
                  </p>
                  {v.motivo && <p class="visita-motivo">{v.motivo}</p>}
                </div>

                <div class="visita-der tabular">
                  <div class="visita-puntos-bloque">
                    {v.estado === "completada" ? (
                      <>
                        <span class:list={["sello-pts", { vencido: !vigente }]}>
                          +{numero.format(pts)} pts
                        </span>
                        <span class:list={["caducidad-texto", { alerta: !vigente }]}>
                          {vigente
                            ? `Caducan ${fecha.format(new Date(`${caduca}T00:00:00Z`))}`
                            : `Vencieron ${fecha.format(new Date(`${caduca}T00:00:00Z`))}`}
                        </span>
                      </>
                    ) : v.estado === "cancelada" ? (
                      <>
                        <span class="pts-neutro">0 pts</span>
                        <span class="caducidad-texto">Cita cancelada</span>
                      </>
                    ) : (
                      <>
                        <span class="pts-neutro">+{numero.format(pts)} al completar</span>
                        <span class="caducidad-texto">
                          Vigencia {MESES_CADUCIDAD_PUNTOS} meses
                        </span>
                      </>
                    )}
                  </div>

                  <a
                    class="boton-icono"
                    href={`/api/citas/${v.id}.pdf`}
                    download
                    aria-label={`Descargar comprobante de cita de ${v.mascota} en PDF`}
                    title="Descargar comprobante PDF"
                  >
                    <Icono nombre="descargar" />
                  </a>
                </div>
              </div>
            );
          })
        )
      }
      <p class="vacio-lista sin-visitas-mascota" hidden>
        Esta mascota todavía no tiene citas registradas.
      </p>
    </div>
  </section>
</article>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>("[data-filtro-mascota]");
  const tarjetas = document.querySelectorAll<HTMLElement>(".tarjeta-visita");
  const sinVisitas = document.querySelector<HTMLElement>(".sin-visitas-mascota");

  chips.forEach((chip) => {
    chip.addEventListener("click", () => {
      const id = chip.dataset.filtroMascota;
      chips.forEach((c) => c.setAttribute("aria-pressed", String(c === chip)));
      let visibles = 0;
      tarjetas.forEach((t) => {
        const mostrar = id === "todas" || t.dataset.mascotaId === id;
        t.hidden = !mostrar;
        if (mostrar) visibles++;
      });
      if (sinVisitas) sinVisitas.hidden = visibles > 0 || tarjetas.length === 0;
    });
  });
</script>

<style>
  .cartilla {
    display: grid;
    grid-template-columns: 330px minmax(0, 1fr);
    border: var(--border);
    border-radius: 18px;
    background-color: var(--color-white);
    overflow: hidden;
  }

  @media (max-width: 880px) {
    .cartilla {
      grid-template-columns: 1fr;
    }
  }

  /* Hoja izquierda */
  .portada {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 20px;
    padding: 24px;
    background-color: var(--color-primary);
    color: var(--color-white);
  }

  .portada-arriba {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .portada-cabecera {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .marca-canela {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .canela-marco {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background-color: var(--color-mint);
    overflow: hidden;
    flex-shrink: 0;
  }

  .canela-svg {
    width: 52px;
    height: 52px;
    display: block;
  }

  .clinica {
    display: block;
    font-family: var(--font-bold);
    font-size: 1.15rem;
    line-height: 1.1;
  }

  .etiqueta-carnet {
    display: block;
    color: var(--color-mint);
    font-size: 0.88rem;
  }

  .folio {
    padding: 4px 10px;
    border-radius: 999px;
    background-color: rgba(255, 255, 255, 0.14);
    font-family: var(--font-bold);
    font-size: 0.82rem;
  }

  .titular-bloque {
    padding-top: 14px;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
  }

  .portada-label {
    margin: 0;
    color: var(--color-mint);
    font-size: 0.85rem;
  }

  .titular-nombre {
    margin: 4px 0 4px;
    font-family: var(--font-bold);
    font-size: 1.4rem;
    line-height: 1.2;
  }

  .titular-meta {
    margin: 2px 0 0;
    color: rgba(255, 255, 255, 0.84);
    font-size: 0.9rem;
    overflow-wrap: anywhere;
  }

  .caja-puntos {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 16px;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 14px;
    background-color: rgba(255, 255, 255, 0.09);
  }

  .caja-puntos-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .pildora-nivel {
    padding: 3px 10px;
    border-radius: 999px;
    background-color: var(--color-accent);
    color: var(--color-white);
    font-family: var(--font-bold);
    font-size: 0.82rem;
  }

  .puntos-cifra {
    margin: 0;
    font-family: var(--font-bold);
    font-size: 2.2rem;
    line-height: 1;

    span {
      font-size: 1rem;
    }
  }

  .barra-progreso {
    height: 10px;
    border-radius: 999px;
    background-color: rgba(255, 255, 255, 0.2);
    overflow: hidden;
  }

  .barra-relleno {
    height: 100%;
    background-color: var(--color-mint);
  }

  .beneficio,
  .siguiente {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.9);
  }

  .siguiente {
    color: var(--color-mint);
    font-family: var(--font-bold);
  }

  .aviso-caducidad {
    padding: 12px 14px;
    border-radius: 12px;
    background-color: var(--color-mint);
    color: var(--color-primary);
    font-size: 0.88rem;
    line-height: 1.45;
  }

  .vencimiento-dato {
    margin-top: 6px;
  }

  .vencidos-nota {
    margin-top: 4px;
    color: #8a3b0c;
    font-family: var(--font-bold);
  }

  .boton-pdf {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    padding: 12px 16px;
    border: none;
    border-radius: 10px;
    background-color: var(--color-white);
    color: var(--color-primary);
    font-family: var(--font-bold);
    font-size: 1rem;
    text-decoration: none;

    &:hover {
      background-color: var(--color-mint);
    }

    &:focus-visible {
      outline: var(--focus-ring);
      outline-offset: 3px;
    }
  }

  /* Hoja derecha */
  .expediente {
    display: flex;
    flex-direction: column;
    min-height: 0;
    background-color: var(--color-surface);
  }

  .expediente-barra {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 16px 20px;
    border-bottom: var(--border);
    background-color: var(--color-white);
  }

  .filtro-chip {
    padding: 7px 14px;
    border: var(--border);
    border-radius: 10px;
    background-color: var(--color-white);
    color: var(--color-primary);
    font-family: var(--font-bold);
    font-size: 0.9rem;
    cursor: pointer;

    &:hover {
      background-color: var(--color-mint);
    }

    &[aria-pressed="true"] {
      background-color: var(--color-primary);
      color: var(--color-white);
    }

    &:focus-visible {
      outline: var(--focus-ring);
      outline-offset: 2px;
    }
  }

  .lista-visitas {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-height: 620px;
    overflow-y: auto;
    padding: 20px;
    overscroll-behavior: contain;

    &:focus-visible {
      outline: var(--focus-ring);
      outline-offset: -3px;
    }
  }

  .tarjeta-visita {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 16px;
    border: var(--border);
    border-radius: 12px;
    background-color: var(--color-white);

    &.caducada,
    &.cancelada {
      border-color: color-mix(in oklch, var(--color-primary) 25%, transparent);
      opacity: 0.78;
    }

    &[hidden] {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .tarjeta-visita {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  .visita-izq {
    min-width: 0;
  }

  .visita-cabecera {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  .visita-servicio {
    font-family: var(--font-bold);
    font-size: 1.02rem;
  }

  .visita-mascota {
    padding: 2px 10px;
    border-radius: 999px;
    background-color: var(--color-mint);
    font-family: var(--font-bold);
    font-size: 0.84rem;
  }

  .visita-meta {
    margin: 4px 0 0;
    color: var(--color-accent-texto);
    font-size: 0.9rem;
  }

  .visita-motivo {
    margin: 4px 0 0;
    color: color-mix(in oklch, var(--color-primary) 72%, white);
    font-size: 0.88rem;
  }

  .visita-der {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }

  .visita-puntos-bloque {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 3px;
  }

  .sello-pts {
    display: inline-block;
    padding: 3px 10px;
    border: 1.5px solid var(--color-primary);
    border-radius: 999px;
    background-color: var(--color-mint);
    font-family: var(--font-bold);
    font-size: 0.9rem;

    &.vencido {
      border-color: color-mix(in oklch, var(--color-primary) 35%, transparent);
      background-color: var(--color-surface);
      text-decoration: line-through;
    }
  }

  .pts-neutro {
    font-family: var(--font-bold);
    font-size: 0.9rem;
    color: color-mix(in oklch, var(--color-primary) 65%, white);
  }

  .caducidad-texto {
    font-size: 0.82rem;
    color: var(--color-accent-texto);

    &.alerta {
      color: #8a3b0c;
      font-family: var(--font-bold);
    }
  }

  .vacio-lista {
    margin: 0;
    padding: 24px;
    border: var(--border);
    border-radius: 12px;
    background-color: var(--color-white);
    text-align: center;

    a {
      color: var(--color-accent-texto);
      font-family: var(--font-bold);
    }
  }

  .tabular {
    font-variant-numeric: tabular-nums;
  }
</style>

---
// Ventana para agendar o cambiar una cita. La usan /dashboard/citas (el personal elige
// cualquier mascota, cualquier día y el estado, para corregir errores) y /cliente/citas
// (el cliente elige una de sus mascotas y un día que no haya pasado). Al elegir el día, la
// página desactiva los horarios ocupados con activarHorarios (src/scripts/sistema.ts)
import { ahoraEnClinica, catalogoServicios, estados, horarios } from "../../lib/citas";
import { pesos } from "../../lib/formato";

type Props = {
  mascotas: { id: string; nombre: string; duenio?: string }[];
  // Solo el personal: elegir el estado y fechas pasadas
  personal?: boolean;
};
const { mascotas, personal = false } = Astro.props;
const hoy = ahoraEnClinica().fecha;
---

<dialog id="cita" class="dialogo" aria-labelledby="titulo-cita">
  <form novalidate>
    <h2 id="titulo-cita">Agendar cita</h2>
    <input type="hidden" name="id" />
    <div class="campos">
      <div class="campo ancho">
        <label for="ci-mascota">Mascota</label>
        <select id="ci-mascota" name="mascota_id" required>
          <option value="">Elige una</option>
          {
            mascotas.map(({ id, nombre, duenio }) => (
              <option value={id}>{duenio ? `${nombre} · ${duenio}` : nombre}</option>
            ))
          }
        </select>
      </div>
      <div class="campo ancho">
        <label for="ci-servicio">Servicio</label>
        <select id="ci-servicio" name="servicio" required>
          <option value="">Elige uno</option>
          {
            Object.entries(catalogoServicios).map(([valor, { nombre, precio }]) => (
              <option value={valor}>
                {nombre} · {pesos.format(precio)}
              </option>
            ))
          }
        </select>
      </div>
      <div class="campo">
        <label for="ci-fecha">Día</label>
        <input id="ci-fecha" name="fecha" type="date" min={personal ? undefined : hoy} required />
      </div>
      <div class="campo">
        <label for="ci-hora">Hora</label>
        <select id="ci-hora" name="hora" required aria-describedby="ci-ayuda">
          <option value="">Elige una</option>
          {horarios.map((hora) => <option value={hora}>{hora}</option>)}
        </select>
      </div>
      <p id="ci-ayuda" class="ayuda-cita ancho">
        Atendemos cada 30 minutos de 9:00 a 19:00. Los horarios ocupados no se pueden elegir.
      </p>
      {
        personal && (
          <div class="campo ancho">
            <label for="ci-estado">Estado</label>
            <select id="ci-estado" name="estado" required>
              {Object.entries(estados).map(([valor, texto]) => (
                <option value={valor}>{texto}</option>
              ))}
            </select>
          </div>
        )
      }
      <div class="campo ancho">
        <label for="ci-motivo">Motivo</label>
        <input id="ci-motivo" name="motivo" autocomplete="off" placeholder="Qué le pasa o qué necesita" />
      </div>
    </div>
    <p class="error-form" role="alert"></p>
    <div class="dialogo-botones">
      <button type="submit" class="boton" formmethod="dialog" formnovalidate value="cancelar">
        Cancelar
      </button>
      <button type="submit" class="boton principal">Agendar cita</button>
    </div>
  </form>
</dialog>

<style>
  .ayuda-cita {
    grid-column: 1 / -1;
    margin: -6px 0 0;
    font-size: 0.95rem;
    line-height: 1.4;
  }
</style>

---
// Íconos de Tabler (outline) que usa el sistema. Van en línea para no pedir archivos y
// para que tomen el color del texto
const trazos = {
  inicio: [
    "M5 12l-2 0l9 -9l9 9l-2 0",
    "M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-7",
    "M9 21v-6a2 2 0 0 1 2 -2h2a2 2 0 0 1 2 2v6",
  ],
  inventario: [
    "M12 3l8 4.5l0 9l-8 4.5l-8 -4.5l0 -9l8 -4.5",
    "M12 12l8 -4.5",
    "M12 12l0 9",
    "M12 12l-8 -4.5",
    "M16 5.25l-8 4.5",
  ],
  proveedores: [
    "M5 17a2 2 0 1 0 4 0a2 2 0 1 0 -4 0",
    "M15 17a2 2 0 1 0 4 0a2 2 0 1 0 -4 0",
    "M5 17h-2v-11a1 1 0 0 1 1 -1h9v12m-4 0h6m4 0h2v-6h-8m0 -5h5l3 5",
  ],
  usuarios: [
    "M5 7a4 4 0 1 0 8 0a4 4 0 1 0 -8 0",
    "M3 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2",
    "M16 3.13a4 4 0 0 1 0 7.75",
    "M21 21v-2a4 4 0 0 0 -3 -3.85",
  ],
  clientes: [
    "M8 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0",
    "M6 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2",
  ],
  cuenta: [
    "M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0",
    "M9 10a3 3 0 1 0 6 0a3 3 0 1 0 -6 0",
    "M6.168 18.849a4 4 0 0 1 3.832 -2.849h4a4 4 0 0 1 3.834 2.855",
  ],
  salir: [
    "M14 8v-2a2 2 0 0 0 -2 -2h-7a2 2 0 0 0 -2 2v12a2 2 0 0 0 2 2h7a2 2 0 0 0 2 -2v-2",
    "M9 12h12l-3 -3",
    "M18 15l3 -3",
  ],
  selector: ["M8 9l4 -4l4 4", "M16 15l-4 4l-4 -4"],
  menu: ["M4 6l16 0", "M4 12l16 0", "M4 18l16 0"],
};

export type NombreIcono = keyof typeof trazos;

const { nombre, class: clase } = Astro.props as { nombre: NombreIcono; class?: string };
---

<svg
  class:list={["icono", clase]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {trazos[nombre].map((d) => <path d={d} />)}
</svg>

<style>
  .icono {
    flex-shrink: 0;
    width: 22px;
    height: 22px;
  }
</style>

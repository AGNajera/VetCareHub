---
import Logo from "../assets/logo.svg";

// Inicio y Nosotros son páginas; los demás van al footer, que está en las dos.
// Las rutas llevan / al principio para que también funcionen desde /nosotros
const enlaces = [
  { href: "/#inicio", texto: "Inicio", ruta: "/" },
  { href: "/nosotros", texto: "Nosotros", ruta: "/nosotros" },
  { href: "#contacto", texto: "Contacto" },
  { href: "#contacto", texto: "Cita" },
  { href: "#contacto", texto: "Ayuda" },
];

const actual = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<div class="sidebar-backdrop" data-sidebar-backdrop></div>

<aside id="sidebar-mobile" class="sidebar" aria-label="Menú" inert>
  <nav>
    {
      enlaces.map(({ href, texto, ruta }) => (
        <a href={href} aria-current={ruta === actual ? "page" : undefined}>
          {texto}
        </a>
      ))
    }
  </nav>

  <a href="/#inicio" class="sidebar-brand">
    <Logo class="sidebar-logo" aria-hidden="true" />
    <span>VetCareHub</span>
  </a>
</aside>

<style>
  /* Queda debajo del header (z-index 10) para que el botón siga visible y
     funcione como la X de cerrar */
  .sidebar {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 9;
    display: flex;
    flex-direction: column;
    width: min(92vw, 420px);
    height: 100dvh;
    padding-top: calc(var(--header-height) + 2px);
    background-color: var(--color-surface);
    border-right: var(--border);
    transform: translateX(-100%);
    visibility: hidden;
    transition:
      transform 280ms cubic-bezier(0.2, 0.8, 0.2, 1),
      visibility 0s linear 280ms;
  }

  .sidebar[data-open] {
    transform: translateX(0);
    visibility: visible;
    transition:
      transform 280ms cubic-bezier(0.2, 0.8, 0.2, 1),
      visibility 0s;
  }

  nav {
    display: flex;
    flex-direction: column;

    a {
      padding: 18px 24px;
      border-bottom: var(--border);
      color: var(--color-primary);
      font-family: var(--font-bold);
      font-size: 1.5rem;
      text-decoration: none;

      &:hover {
        text-decoration: underline;
      }

      &:focus-visible {
        outline: var(--focus-ring);
        outline-offset: -3px;
      }

      /* Mismo marcador de página actual que el menú de escritorio */
      &[aria-current="page"] {
        background-color: var(--color-primary);
        color: var(--color-white);
      }
    }
  }

  /* Logo hasta abajo: margin-top auto lo empuja al final del sidebar */
  .sidebar-brand {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: auto;
    padding: 24px;
    border-top: var(--border);
    color: var(--color-primary);
    font-family: var(--font-bold);
    font-size: 1.35rem;
    text-decoration: none;

    &:focus-visible {
      outline: var(--focus-ring);
      outline-offset: -3px;
    }
  }

  .sidebar-logo {
    width: 56px;
    height: 56px;
    flex-shrink: 0;
  }

  .sidebar-backdrop {
    position: fixed;
    inset: 0;
    z-index: 8;
    /* Solo desenfoca la página de atrás, sin oscurecerla */
    backdrop-filter: blur(6px);
    opacity: 0;
    /* Con opacity 0 el navegador puede seguir calculando el blur de toda la página;
       visibility lo apaga por completo mientras el menú está cerrado */
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 280ms ease,
      visibility 0s linear 280ms;
  }

  .sidebar-backdrop[data-open] {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition:
      opacity 280ms ease,
      visibility 0s;
  }

  @media (prefers-reduced-motion: reduce) {
    .sidebar,
    .sidebar[data-open],
    .sidebar-backdrop,
    .sidebar-backdrop[data-open] {
      transition: none;
    }
  }
</style>

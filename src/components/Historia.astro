---
import Consulta from "../assets/consulta.svg";
import Vacunacion from "../assets/vacunacion.svg";
import Clinica from "../assets/clinica.svg";
import Mascota from "../assets/mascota.svg";

const capitulos = [
  {
    Svg: Consulta,
    alt: "Perro sentado en la mesa de revisión del consultorio",
    anio: 2012,
    titulo: "El primer consultorio",
    texto:
      "Abrimos sobre la avenida Emiliano Zapata con una mesa de revisión, una báscula y un botiquín. Las consultas eran con cita y las urgencias, a la hora que llegaran.",
  },
  {
    Svg: Vacunacion,
    alt: "Gato con una curita junto a su cartilla de vacunación",
    anio: 2015,
    titulo: "Sábados de vacunación",
    texto:
      "Empezamos a vacunar los sábados a los perros y gatos del barrio. De ahí viene la costumbre de anotar cada dosis en la cartilla y avisar cuando toca la siguiente.",
  },
  {
    Svg: Clinica,
    alt: "Fachada de la clínica VetCareHub con un perrito paseando",
    anio: 2019,
    titulo: "La clínica de hoy",
    texto:
      "Nos cambiamos al número 123, con quirófano, laboratorio y hospitalización separada para perros y gatos. Desde entonces casi todo se resuelve aquí mismo.",
  },
  {
    Svg: Mascota,
    alt: "Canela, la perrita de la clínica, sentada",
    anio: 2022,
    titulo: "Llegó Canela",
    texto:
      "Entró como paciente, sin dueño y con una pata lastimada. Se recuperó, se quedó y ahora recibe a quien cruza la puerta. Es la mascota de la clínica.",
  },
];
---

<section class="section historia" style={`--pasos: ${capitulos.length}`}>
  <div class="panel">
    <h2>Nuestra historia</h2>

    <div class="escena" data-lado="izquierda">
      <div class="retrato">
        {
          capitulos.map(({ Svg, alt }, i) => (
            <Svg
              class:list={["imagen", { "is-active": i === 0 }]}
              role="img"
              preserveAspectRatio="xMidYMid slice"
              aria-label={alt}
              aria-hidden={i === 0 ? "false" : "true"}
            />
          ))
        }
      </div>

      <ol class="capitulos">
        {
          capitulos.map(({ anio, titulo, texto }, i) => (
            <li class:list={["capitulo", { "is-active": i === 0 }]}>
              <h3>
                <span class="anio">{anio}</span>
                {titulo}
              </h3>
              <p>{texto}</p>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="linea" role="group" aria-label="Años de la historia">
      {
        capitulos.map(({ anio }, i) => (
          <button type="button" aria-current={i === 0 ? "true" : "false"}>
            {anio}
          </button>
        ))
      }
    </div>
  </div>

  <!-- Espacio vacío que se recorre con el scroll mientras el panel está fijo -->
  <div class="recorrido" aria-hidden="true"></div>
</section>

<script>
  const historia = document.querySelector<HTMLElement>(".historia");
  const panel = historia?.querySelector<HTMLElement>(".panel");
  const escena = historia?.querySelector<HTMLElement>(".escena");
  const recorrido = historia?.querySelector<HTMLElement>(".recorrido");

  if (historia && panel && escena && recorrido) {
    const imagenes = [...historia.querySelectorAll<SVGSVGElement>(".imagen")];
    const capitulos = [...historia.querySelectorAll<HTMLElement>(".capitulo")];
    const anios = [
      ...historia.querySelectorAll<HTMLButtonElement>(".linea button"),
    ];
    let actual = 0;

    const mostrar = (indice: number) => {
      if (indice === actual) return;
      actual = indice;
      // El círculo empieza a la izquierda y cruza al otro lado en cada capítulo
      escena.dataset.lado = indice % 2 === 0 ? "izquierda" : "derecha";
      imagenes.forEach((imagen, i) => {
        imagen.classList.toggle("is-active", i === indice);
        imagen.setAttribute("aria-hidden", String(i !== indice));
      });
      capitulos.forEach((capitulo, i) =>
        capitulo.classList.toggle("is-active", i === indice),
      );
      anios.forEach((anio, i) =>
        anio.setAttribute("aria-current", String(i === indice)),
      );
    };

    // Mientras el panel está fijo su orilla de abajo no se mueve y `recorrido` sigue
    // subiendo; lo que se han separado es lo que se ha avanzado en la historia
    const alDesplazar = () => {
      const largo = recorrido.offsetHeight;
      // Sin `recorrido` (pantalla muy bajita) los capítulos se leen en lista
      if (!largo) return;
      const avance =
        (panel.getBoundingClientRect().bottom -
          recorrido.getBoundingClientRect().top) /
        largo;
      const indice = Math.floor(avance * capitulos.length);
      mostrar(Math.max(0, Math.min(capitulos.length - 1, indice)));
    };

    // Los años llevan a la mitad del tramo de scroll de su capítulo
    anios.forEach((anio, i) =>
      anio.addEventListener("click", () => {
        const inicio =
          window.scrollY +
          recorrido.getBoundingClientRect().top -
          panel.offsetHeight -
          parseFloat(getComputedStyle(panel).top);
        const tramo = recorrido.offsetHeight / capitulos.length;
        window.scrollTo({ top: inicio + tramo * (i + 0.5) });
      }),
    );

    // El panel fijo solo se activa con JS; sin él los capítulos quedan en lista
    historia.toggleAttribute("data-fija", true);
    window.addEventListener("scroll", alDesplazar, { passive: true });
    window.addEventListener("resize", alDesplazar);
    alDesplazar();
  }
</script>

<style>
  .historia {
    /* Cuánto scroll dura cada capítulo mientras el panel está fijo */
    --paso: 60vh;
    /* Alto del header sticky más un margen */
    --arriba: 70px;
    /* También depende del alto para que quepa en el panel fijo */
    --retrato: clamp(200px, min(32vw, 46svh), 380px);
    --hueco: clamp(24px, 4vw, 48px);
    /* Lo que se recorre el texto cuando el círculo cruza a la derecha */
    --cruce-texto: calc(-1 * (var(--retrato) + var(--hueco)));

    padding-block: 16px 56px;
  }

  .panel {
    display: grid;
    gap: 20px;
    padding: clamp(18px, 4vw, 40px);
    border: var(--border);
    border-radius: 24px;
    background-color: var(--color-mint);

    h2 {
      margin: 0;
    }
  }

  /* Es contenedor para que el círculo pueda medir el ancho de la escena con cqw */
  .escena {
    container-type: inline-size;
    display: grid;
    grid-template-columns: var(--retrato) minmax(0, 1fr);
    align-items: start;
    gap: var(--hueco);
  }

  .retrato {
    position: relative;
    /* Pasa por encima del texto cuando se cruzan */
    z-index: 1;
    width: var(--retrato);
    aspect-ratio: 1;
    border: var(--border);
    border-radius: 50%;
    overflow: hidden;
    background-color: var(--color-white);
  }

  .imagen {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 600ms ease;
  }

  .imagen.is-active {
    opacity: 1;
  }

  .capitulos {
    display: grid;
    gap: 28px;
    margin: 0;
    padding: clamp(18px, 3vw, 32px);
    list-style: none;
    border: var(--border);
    border-radius: 14px;
    background-color: var(--color-white);
  }

  .capitulo {
    h3 {
      margin: 0 0 8px;
      font-family: var(--font-bold);
      font-size: 1.3rem;
    }

    .anio {
      display: block;
      margin-bottom: 6px;
      color: var(--color-accent);
      font-size: 2.6rem;
      line-height: 1;
    }

    p {
      max-width: 52ch;
      margin: 0;
      font-size: 1.1rem;
      line-height: 1.55;
    }
  }

  .linea,
  .recorrido {
    display: none;
  }

  /* La línea del tiempo pasa por detrás de los años */
  .linea {
    position: relative;
    justify-content: space-between;
    align-items: center;

    &::before {
      content: "";
      position: absolute;
      inset-inline: 0;
      top: 50%;
      border-top: var(--border);
      translate: 0 -1px;
    }

    button {
      position: relative;
      padding: 6px 16px;
      border: var(--border);
      border-radius: 999px;
      background-color: var(--color-white);
      color: var(--color-primary);
      font-family: var(--font-bold);
      font-size: 1rem;
      cursor: pointer;

      &:hover {
        text-decoration: underline;
      }

      &:focus-visible {
        outline: var(--focus-ring);
        outline-offset: 2px;
      }

      &[aria-current="true"] {
        background-color: var(--color-primary);
        color: var(--color-white);
      }
    }
  }

  @media (max-width: 640px) {
    .historia {
      --arriba: 66px;
      /* Lo que sobra de alto después del título, el texto y los años */
      --retrato: clamp(110px, 100svh - 490px, 52vw);
      /* En celular el texto se queda abajo y solo cruza el círculo */
      --cruce-texto: 0px;
    }

    .panel {
      gap: 14px;
    }

    .escena {
      grid-template-columns: minmax(0, 1fr);
      gap: 14px;
    }

    .linea button {
      padding: 5px 11px;
      font-size: 0.95rem;
    }

    .capitulo {
      .anio {
        font-size: 2rem;
      }

      h3 {
        font-size: 1.2rem;
      }

      p {
        font-size: 1rem;
        line-height: 1.5;
      }
    }
  }

  /* Panel fijo: se queda pegado debajo del header mientras se recorre `recorrido`,
     y en cada capítulo cambian el lado del círculo, la imagen y el texto.
     data-fija lo pone el script; en pantallas muy bajitas no cabría y se deja la lista */
  @media (min-height: 600px) {
    .historia[data-fija] {
      .panel {
        position: sticky;
        top: var(--arriba);
        grid-template-rows: auto minmax(0, 1fr) auto;
        height: calc(100svh - var(--arriba) - 16px);
      }

      .recorrido {
        display: block;
        height: calc(var(--pasos) * var(--paso));
      }

      .linea {
        display: flex;
      }

      .escena {
        align-content: center;
        align-items: center;
      }

      .retrato,
      .capitulos {
        transition: translate 800ms cubic-bezier(0.65, 0, 0.35, 1);
      }

      .escena[data-lado="derecha"] {
        .retrato {
          translate: calc(100cqw - 100%) 0;
        }

        .capitulos {
          translate: var(--cruce-texto) 0;
        }
      }

      /* Todos los capítulos ocupan la misma celda, así la caja no cambia de alto */
      .capitulos {
        gap: 0;
      }

      /* Se ocultan solo con opacity para que un lector de pantalla pueda leerlos todos;
         pointer-events evita seleccionar por accidente el texto de uno invisible */
      .capitulo {
        grid-area: 1 / 1;
        opacity: 0;
        pointer-events: none;
        transition: opacity 300ms ease;
      }

      /* El que entra espera a que el círculo vaya a medio camino */
      .capitulo.is-active {
        opacity: 1;
        pointer-events: auto;
        transition: opacity 450ms ease 300ms;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .imagen {
      transition: none;
    }

    .historia[data-fija] {
      .retrato,
      .capitulos,
      .capitulo,
      .capitulo.is-active {
        transition: none;
      }
    }
  }
</style>

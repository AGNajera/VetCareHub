---
// Ilustraciones propias de la historia, cuadradas porque van recortadas en círculo
import Consultorio from "../assets/historia-consultorio.svg";
import Sabados from "../assets/historia-sabados.svg";
import Quirofano from "../assets/historia-quirofano.svg";
import Canela from "../assets/historia-canela.svg";

const capitulos = [
  {
    Svg: Consultorio,
    alt: "Consultorio con una mesa de revisión, una báscula y un botiquín",
    anio: 2012,
    titulo: "El primer consultorio",
    texto:
      "Abrimos sobre la avenida Emiliano Zapata con una mesa de revisión, una báscula y un botiquín. Las consultas eran con cita y las urgencias, a la hora que llegaran.",
  },
  {
    Svg: Sabados,
    alt: "Un perrito y un gato en la fila, bajo un calendario con los sábados marcados",
    anio: 2015,
    titulo: "Sábados de vacunación",
    texto:
      "Empezamos a vacunar los sábados a los perros y gatos del barrio. De ahí viene la costumbre de anotar cada dosis en la cartilla y avisar cuando toca la siguiente.",
  },
  {
    Svg: Quirofano,
    alt: "Quirófano con su lámpara, un monitor de signos vitales y las jaulas de hospitalización",
    anio: 2019,
    titulo: "La clínica de hoy",
    texto:
      "Nos cambiamos al número 123, con quirófano, laboratorio y hospitalización separada para perros y gatos. Desde entonces casi todo se resuelve aquí mismo.",
  },
  {
    Svg: Canela,
    alt: "Canela, con una pata vendada, sentada junto a la puerta de la clínica",
    anio: 2022,
    titulo: "Llegó Canela",
    texto:
      "Entró como paciente, sin dueño y con una pata lastimada. Se recuperó, se quedó y ahora recibe a quien cruza la puerta. Es la mascota de la clínica.",
  },
];
---

<section class="section historia">
  <div class="panel">
    <h2>Nuestra historia</h2>

    <!-- Pista horizontal: cada capítulo es una lámina y se pasa de una a otra deslizando
         de lado. tabindex la deja recorrerse también con las flechas del teclado -->
    <div class="visor">
      <ol class="capitulos" tabindex="0" aria-label="Capítulos de la historia">
        {
          capitulos.map(({ Svg, alt, anio, titulo, texto }, i) => (
            <li class:list={["capitulo", { "is-active": i === 0 }]}>
              <div class="retrato">
                <Svg
                  class="imagen"
                  role="img"
                  preserveAspectRatio="xMidYMid slice"
                  aria-label={alt}
                />
              </div>
              <div class="texto">
                <h3>
                  <span class="anio">{anio}</span>
                  {titulo}
                </h3>
                <p>{texto}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <!-- Una flecha en cada orilla, encima de la lámina vecina que se asoma -->
      <button
        class="flecha anterior"
        type="button"
        aria-label="Capítulo anterior"
        disabled
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M15 6l-6 6l6 6"></path>
        </svg>
      </button>
      <button class="flecha siguiente" type="button" aria-label="Capítulo siguiente">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M9 6l6 6l-6 6"></path>
        </svg>
      </button>
    </div>

    <div class="linea" role="group" aria-label="Años de la historia">
      {
        capitulos.map(({ anio }, i) => (
          <button type="button" aria-current={i === 0 ? "true" : "false"}>
            {anio}
          </button>
        ))
      }
    </div>
  </div>
</section>

<script>
  const historia = document.querySelector<HTMLElement>(".historia");
  const pista = historia?.querySelector<HTMLElement>(".capitulos");

  const anterior = historia?.querySelector<HTMLButtonElement>(".anterior");
  const siguiente = historia?.querySelector<HTMLButtonElement>(".siguiente");

  if (historia && pista && anterior && siguiente) {
    const capitulos = [...pista.querySelectorAll<HTMLElement>(".capitulo")];
    const anios = [
      ...historia.querySelectorAll<HTMLButtonElement>(".linea button"),
    ];
    let actual = 0;

    // Centro de la lámina medido dentro de la pista
    const centro = (capitulo: HTMLElement) =>
      capitulo.offsetLeft + capitulo.offsetWidth / 2;

    // El capítulo actual es el que quedó más cerca del centro de la pista.
    // Como el scroll-snap siempre termina en una lámina centrada, el año no parpadea
    const alDesplazar = () => {
      const medio = pista.scrollLeft + pista.clientWidth / 2;
      let indice = 0;
      capitulos.forEach((capitulo, i) => {
        if (
          Math.abs(centro(capitulo) - medio) <
          Math.abs(centro(capitulos[indice]) - medio)
        )
          indice = i;
      });
      if (indice === actual) return;
      actual = indice;
      capitulos.forEach((capitulo, i) =>
        capitulo.classList.toggle("is-active", i === indice),
      );
      anios.forEach((anio, i) =>
        anio.setAttribute("aria-current", String(i === indice)),
      );
      // En las orillas la flecha que ya no lleva a ningún lado se quita
      anterior.disabled = indice === 0;
      siguiente.disabled = indice === capitulos.length - 1;
    };

    const irA = (indice: number) => {
      const capitulo = capitulos[indice];
      if (capitulo)
        pista.scrollTo({ left: centro(capitulo) - pista.clientWidth / 2 });
    };

    anios.forEach((anio, i) => anio.addEventListener("click", () => irA(i)));
    anterior.addEventListener("click", () => irA(actual - 1));
    siguiente.addEventListener("click", () => irA(actual + 1));

    // Los años y las flechas solo funcionan con JS; sin él queda la pista, que se desliza sola
    historia.toggleAttribute("data-controles", true);
    pista.addEventListener("scroll", alDesplazar, { passive: true });
    alDesplazar();
  }
</script>

<style>
  /* La historia ocupa todo el ancho de la página, no la columna de 1080px de .section */
  .historia {
    --retrato: clamp(200px, 28vw, 320px);
    --hueco: clamp(24px, 4vw, 48px);
    /* Misma columna que el resto de las secciones, para alinear el título y los años */
    --margen: max(16px, (100% - 1080px) / 2 + 16px);

    width: 100%;
    padding: 16px 0 56px;
  }

  /* Es contenedor para que las láminas midan su ancho con cqw */
  .panel {
    container-type: inline-size;
    display: grid;
    /* minmax(0, …) para que la pista no ensanche la columna a todo su contenido:
       si la columna crece, la pista ya no se desborda y no hay nada que deslizar */
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
    padding-block: clamp(18px, 4vw, 40px);
    border-block: var(--border);
    background-color: var(--color-mint);

    h2 {
      margin: 0;
      padding-inline: var(--margen);
    }
  }

  .visor {
    position: relative;
  }

  .capitulos {
    /* Más angosta que la pista: las láminas vecinas se asoman a los lados y así se ve
       que la historia sigue en horizontal */
    --lamina: min(100cqw - 128px, 860px);

    /* Para que offsetLeft de cada capítulo se mida desde la pista */
    position: relative;
    display: flex;
    gap: var(--hueco);
    margin: 0;
    /* Deja que la primera y la última también queden centradas */
    padding: 0 calc((100cqw - var(--lamina)) / 2);
    list-style: none;
    overflow-x: auto;
    /* Sin esto overflow-x la vuelve deslizable también en vertical y se queda con la
       rueda del mouse en vez de dejar bajar la página */
    overflow-y: hidden;
    /* mandatory + stop: cada gesto avanza un solo capítulo, por fuerte que sea */
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    /* Al llegar a la orilla no dispara el gesto de "página anterior" del navegador */
    overscroll-behavior-x: contain;
    /* Los años de abajo hacen de barra */
    scrollbar-width: none;

    &:focus-visible {
      outline: var(--focus-ring);
      outline-offset: -3px;
    }
  }

  .capitulo {
    flex: 0 0 var(--lamina);
    display: grid;
    grid-template-columns: var(--retrato) minmax(0, 1fr);
    align-items: center;
    gap: var(--hueco);
    scroll-snap-align: center;
    scroll-snap-stop: always;
    transition: opacity 300ms ease;
  }

  /* El círculo cambia de lado en cada capítulo */
  .capitulo:nth-child(even) {
    grid-template-columns: minmax(0, 1fr) var(--retrato);

    .retrato {
      order: 1;
    }
  }

  /* Las vecinas se apagan para que se lea solo la del centro. Lo marca el script */
  .historia[data-controles] .capitulo:not(.is-active) {
    opacity: 0.4;
  }

  .flecha {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    display: none;
    place-items: center;
    width: 48px;
    height: 48px;
    padding: 0;
    border: var(--border);
    border-radius: 50%;
    background-color: var(--color-white);
    color: var(--color-primary);
    cursor: pointer;
    transition: opacity 200ms ease;

    svg {
      width: 26px;
      height: 26px;
      fill: none;
      stroke: currentColor;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    &:focus-visible {
      outline: var(--focus-ring);
      outline-offset: 3px;
    }

    &:disabled {
      visibility: hidden;
    }
  }

  .anterior {
    left: clamp(8px, 2cqw, 32px);
  }

  .siguiente {
    right: clamp(8px, 2cqw, 32px);
  }

  /* Con mouse las flechas solo salen al pasar por la historia (o al llegar con el teclado);
     en pantallas táctiles no hay hover y se quedan siempre a la vista */
  @media (hover: hover) and (pointer: fine) {
    .flecha {
      opacity: 0;
    }

    /* Va aquí porque en táctil el hover se queda pegado después de tocar la flecha */
    .flecha:hover {
      background-color: var(--color-primary);
      color: var(--color-white);
    }

    .panel:hover .flecha,
    .flecha:focus-visible {
      opacity: 1;
    }
  }

  .retrato {
    width: var(--retrato);
    aspect-ratio: 1;
    border: var(--border);
    border-radius: 50%;
    overflow: hidden;
    background-color: var(--color-white);
  }

  .imagen {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Solo se mueve la ilustración del capítulo que se está leyendo. Las clases vienen de los
     archivos en src/assets, por eso se usa :global (Astro no les pone su atributo de scope) */
  @media (prefers-reduced-motion: no-preference) {
    .retrato :global(:is(.cola, .ojos, .corazon, .lampara, .foco)) {
      transform-box: fill-box;
      transform-origin: center;
    }

    .capitulo.is-active {
      :global(.cola) {
        transform-origin: left bottom;
        animation: menear 0.8s ease-in-out infinite;
      }

      :global(.ojos) {
        animation: parpadear 3s ease-in-out infinite;
      }

      :global(.corazon) {
        animation: latir 0.9s ease-in-out infinite;
      }

      :global(.lampara) {
        transform-origin: center top;
        animation: balancear 3.2s ease-in-out infinite;
      }

      :global(.luz) {
        animation: alumbrar 2.4s ease-in-out infinite;
      }

      /* Las luces de las jaulas laten una después de la otra */
      :global(.foco) {
        animation: latir 1.6s ease-in-out infinite;
      }

      :global(.foco ~ .foco) {
        animation-delay: 0.8s;
      }

    }
  }

  @keyframes alumbrar {
    0%,
    100% {
      opacity: 0.2;
    }
    50% {
      opacity: 0.75;
    }
  }

  .texto {
    padding: clamp(18px, 3vw, 32px);
    border: var(--border);
    border-radius: 14px;
    background-color: var(--color-white);

    h3 {
      margin: 0 0 8px;
      font-family: var(--font-bold);
      font-size: 1.3rem;
    }

    .anio {
      display: block;
      margin-bottom: 6px;
      color: var(--color-accent);
      font-size: 2.6rem;
      line-height: 1;
    }

    p {
      max-width: 52ch;
      margin: 0;
      font-size: 1.1rem;
      line-height: 1.55;
    }
  }

  /* La línea del tiempo pasa por detrás de los años */
  .linea {
    position: relative;
    display: none;
    margin-inline: var(--margen);
    justify-content: space-between;
    align-items: center;

    &::before {
      content: "";
      position: absolute;
      inset-inline: 0;
      top: 50%;
      border-top: var(--border);
      translate: 0 -1px;
    }

    button {
      position: relative;
      padding: 6px 16px;
      border: var(--border);
      border-radius: 999px;
      background-color: var(--color-white);
      color: var(--color-primary);
      font-family: var(--font-bold);
      font-size: 1rem;
      cursor: pointer;

      &:hover {
        text-decoration: underline;
      }

      &:focus-visible {
        outline: var(--focus-ring);
        outline-offset: 2px;
      }

      &[aria-current="true"] {
        background-color: var(--color-primary);
        color: var(--color-white);
      }
    }
  }

  /* data-controles lo pone el script */
  .historia[data-controles] .linea {
    display: flex;
  }

  .historia[data-controles] .flecha {
    display: grid;
  }

  @media (max-width: 640px) {
    .historia {
      --retrato: min(48cqw, 240px);
    }

    .panel {
      gap: 14px;
    }

    .capitulos {
      --lamina: calc(100cqw - 64px);
      gap: 16px;
    }

    /* En celular el texto va abajo y el círculo al centro, con una flecha de cada lado */
    .capitulo,
    .capitulo:nth-child(even) {
      grid-template-columns: minmax(0, 1fr);
      align-content: start;
      gap: 14px;
    }

    .capitulo .retrato,
    .capitulo:nth-child(even) .retrato {
      order: 0;
      justify-self: center;
    }

    .flecha {
      top: calc(var(--retrato) / 2);
      width: 40px;
      height: 40px;
    }

    .linea button {
      padding: 5px 11px;
      font-size: 0.95rem;
    }

    .texto {
      .anio {
        font-size: 2rem;
      }

      h3 {
        font-size: 1.2rem;
      }

      p {
        font-size: 1rem;
        line-height: 1.5;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .capitulos {
      scroll-behavior: auto;
    }

    .capitulo,
    .flecha {
      transition: none;
    }
  }
</style>

---
// Importados como componentes para que el SVG quede inline y el CSS pueda animar sus partes
import Consulta from "../assets/consulta.svg";
import Vacunacion from "../assets/vacunacion.svg";
import Clinica from "../assets/clinica.svg";

const images = [
  {
    Svg: Consulta,
    alt: "Perro sentado en la mesa de revisión del consultorio",
  },
  {
    Svg: Vacunacion,
    alt: "Gato con una curita junto a su cartilla de vacunación",
  },
  {
    Svg: Clinica,
    alt: "Fachada de la clínica VetCareHub con un perrito paseando",
  },
];
---

<section
  class="carrusel"
  aria-roledescription="carrusel"
  aria-label="Galería de VetCareHub"
>
  <div class="images">
    {
      images.map(({ Svg, alt }, i) => (
        <Svg
          class:list={["image", { "is-active": i === 0 }]}
          role="img"
          preserveAspectRatio="xMidYMid slice"
          aria-label={alt}
          aria-hidden={i === 0 ? "false" : "true"}
        />
      ))
    }
  </div>

  <button class="arrow prev" type="button" aria-label="Imagen anterior">
    <svg viewBox="0 0 24 24" aria-hidden="true"
      ><path d="M15 6l-6 6l6 6"></path></svg
    >
  </button>
  <button class="arrow next" type="button" aria-label="Imagen siguiente">
    <svg viewBox="0 0 24 24" aria-hidden="true"
      ><path d="M9 6l6 6l-6 6"></path></svg
    >
  </button>

  <div class="dots">
    {
      images.map((_, i) => (
        <button
          class="dot"
          type="button"
          aria-label={`Ver imagen ${i + 1} de ${images.length}`}
          aria-current={i === 0 ? "true" : "false"}
        />
      ))
    }
  </div>
</section>

<script>
  const carrusel = document.querySelector<HTMLElement>(".carrusel");
  if (carrusel) {
    const images = [...carrusel.querySelectorAll<SVGSVGElement>(".image")];
    const dots = [...document.querySelectorAll<HTMLButtonElement>(".dot")];
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    let current = 0;
    let timer = 0;

    const show = (index: number) => {
      current = (index + images.length) % images.length;
      images.forEach((image, i) => {
        image.classList.toggle("is-active", i === current);
        image.setAttribute("aria-hidden", String(i !== current));
      });
      // Se reinicia solo en la imagen que entra, así la que sale no brinca durante el fade
      images[current].classList.remove("recorrido");
      dots.forEach((dot, i) =>
        dot.setAttribute("aria-current", String(i === current)),
      );
    };

    // Avance automático cada 6s. Cuando el mouse está en el carrusel se pausa la animación.
    function start() {
      if (reduceMotion) return;
      stop();
      timer = window.setInterval(() => show(current + 1), 6000);
    }

    const stop = () => window.clearInterval(timer);

    carrusel.querySelector(".prev")?.addEventListener("click", () => {
      show(current - 1);
      start();
    });
    carrusel.querySelector(".next")?.addEventListener("click", () => {
      show(current + 1);
      start();
    });
    dots.forEach((dot, i) =>
      dot.addEventListener("click", () => {
        show(i);
        start();
      }),
    );

    // El recorrido (el perrito caminando a la puerta) se queda terminado aunque el mouse salga,
    // hasta que se cambie de imagen
    carrusel
      .querySelector(".images")
      ?.addEventListener("mouseenter", () =>
        images[current].classList.add("recorrido"),
      );

    carrusel.addEventListener("mouseenter", stop);
    carrusel.addEventListener("mouseleave", start);
    carrusel.addEventListener("focusin", stop);
    carrusel.addEventListener("focusout", start);

    start();
  }
</script>

<style>
  .carrusel {
    /* Tamaño de las imágenes; las flechas usan el alto para centrarse verticalmente */
    --images-width: clamp(300px, 56vw, 620px);
    --images-height: calc(var(--images-width) * 3 / 4);
    /* Qué tanto de la parte de abajo se difumina hacia el fondo de la página */
    --fade: 30%;
    --padding-top: 40px;

    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    width: 100%;
    padding: var(--padding-top) 16px 72px;
  }

  .images {
    position: relative;
    width: var(--images-width);
    height: var(--images-height);
    overflow: hidden;
    border-radius: 24px 24px 0 0;
    /* Solo la orilla de abajo se desvanece, así la imagen se funde con el fondo de la página */
    mask-image: linear-gradient(to bottom, #000 calc(100% - var(--fade)), transparent);
  }

  .image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 700ms ease;
  }

  .image.is-active {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .image {
      transition: none;
    }
  }

  /* Animaciones de las partes de cada SVG al hacer hover. Las clases vienen de los archivos en src/assets,
     por eso se usa :global (Astro no les pone su atributo de scope). */
  @media (prefers-reduced-motion: no-preference) {
    .images :global(:is(.cola, .estetoscopio, .ojos, .corazon, .jeringa, .nubes, .sol, .perrito)) {
      transform-box: fill-box;
      transform-origin: center;
    }

    .images:hover {
      :global(.cola) {
        transform-origin: left bottom;
        animation: menear 0.8s ease-in-out infinite;
      }

      :global(.estetoscopio) {
        transform-origin: center top;
        animation: balancear 3.2s ease-in-out infinite;
      }

      :global(.ojos) {
        animation: parpadear 3s ease-in-out infinite;
      }

      :global(.corazon) {
        animation: latir 0.9s ease-in-out infinite;
      }

      :global(.jeringa) {
        animation: flotar 3.6s ease-in-out infinite;
      }

      :global(.nubes) {
        animation: desplazar 8s ease-in-out infinite;
      }

      :global(.sol) {
        animation: latir 2.4s ease-in-out infinite;
      }
    }

    .recorrido :global(.perrito) {
      animation: pasear 3s ease-in-out forwards;
    }
  }

  /* Todas empiezan y terminan en la posición original (0%, 100%) para que al hacer hover
     el movimiento arranque suave y no brinque directo a un extremo */
  @keyframes menear {
    0%,
    100% {
      rotate: 0deg;
    }
    25% {
      rotate: -10deg;
    }
    75% {
      rotate: 10deg;
    }
  }

  @keyframes balancear {
    0%,
    100% {
      rotate: 0deg;
    }
    25% {
      rotate: -6deg;
    }
    75% {
      rotate: 6deg;
    }
  }

  @keyframes parpadear {
    0%,
    90%,
    100% {
      scale: 1 1;
    }
    95% {
      scale: 1 0.1;
    }
  }

  @keyframes latir {
    0%,
    100% {
      scale: 1;
    }
    50% {
      scale: 1.15;
    }
  }

  @keyframes flotar {
    0%,
    100% {
      translate: 0 0;
    }
    25% {
      translate: 0 -8px;
    }
    75% {
      translate: 0 8px;
    }
  }

  @keyframes desplazar {
    0%,
    100% {
      translate: 0 0;
    }
    25% {
      translate: -20px 0;
    }
    75% {
      translate: 20px 0;
    }
  }

  @keyframes pasear {
    from {
      translate: 0 0;
    }
    to {
      /* Hasta la puerta de la clínica */
      translate: 330px 0;
    }
  }

  .arrow {
    position: absolute;
    top: calc(var(--padding-top) + var(--images-height) / 2);
    translate: 0 -50%;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    padding: 0;
    border: var(--border);
    border-radius: 50%;
    background-color: rgb(255 255 255 / 80%);
    color: var(--color-primary);
    cursor: pointer;

    svg {
      width: 26px;
      height: 26px;
      fill: none;
      stroke: currentColor;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    &:hover {
      background-color: var(--color-primary);
      color: var(--color-white);
    }

    &:focus-visible {
      outline: var(--focus-ring);
      outline-offset: 3px;
    }
  }

  .prev {
    left: clamp(8px, 6vw, 96px);
  }

  .next {
    right: clamp(8px, 6vw, 96px);
  }

  .caption {
    margin: 8px 0 0;
    font-size: 1.1rem;
  }

  .dots {
    display: flex;
    gap: 10px;
  }

  .dot {
    width: 12px;
    height: 12px;
    padding: 0;
    border: var(--border);
    border-radius: 50%;
    background: transparent;
    cursor: pointer;

    &[aria-current="true"] {
      background-color: var(--color-primary);
    }

    &:focus-visible {
      outline: var(--focus-ring);
      outline-offset: 2px;
    }
  }
</style>

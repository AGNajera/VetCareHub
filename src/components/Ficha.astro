---
// Ficha de una persona del organigrama. Todas son iguales: foto, nombre, puesto y
// el correo, que solo sale al pasar por encima
const { nombre, puesto, correo, foto } = Astro.props;

// El correo se parte en la arroba para que quepa en dos renglones
const [usuario, dominio] = correo.split("@");
---

<!-- tabindex="-1" para que en celular, donde no hay hover, la ficha se abra al tocarla -->
<article class="ficha" tabindex="-1">
  <div class="tarjeta">
    <div class="foto">
      {
        foto ? (
          <img
            src={foto.src}
            width={foto.width}
            height={foto.height}
            alt=""
            loading="lazy"
            decoding="async"
          />
        ) : (
          // Espacio de la foto mientras no hay una
          <svg viewBox="0 0 100 100" aria-hidden="true">
            <circle cx="50" cy="38" r="17" />
            <path d="M16 100c0-21 15-34 34-34s34 13 34 34z" />
          </svg>
        )
      }
    </div>
    <h3>{nombre}</h3>
  </div>
  <p class="puesto">{puesto}</p>
  <p class="correo">
    <span>Correo</span>
    <a href={`mailto:${correo}`}>{usuario}<wbr />@{dominio}</a>
  </p>
</article>

<script>
  // En celular el primer toque solo abre la ficha. Como el correo aparece en ese mismo
  // toque y cubre la foto, el navegador le pasaba el click al enlace y abría la app de
  // correo. Por eso, si al tocar la ficha todavía estaba cerrada, ese click no cuenta;
  // ya abierta, el siguiente toque sí abre el correo. Con el mouse y el teclado no
  // cambia nada
  document.querySelectorAll<HTMLElement>(".ficha").forEach((ficha) => {
    const enlace = ficha.querySelector<HTMLAnchorElement>(".correo a");
    let estabaCerrada = false;

    ficha.addEventListener("pointerdown", (event) => {
      estabaCerrada =
        event.pointerType !== "mouse" && !ficha.matches(":focus-within");
    });

    enlace?.addEventListener("click", (event) => {
      if (estabaCerrada) event.preventDefault();
      estabaCerrada = false;
    });
  });
</script>

<style>
  /* Las medidas (--ficha, --correo) las pone el organigrama, que también puede achicar
     la letra con --letra-nombre y --letra-puesto */
  .ficha {
    position: relative;
    /* Para que el correo se pueda esconder detrás de la tarjeta sin irse detrás de la página */
    isolation: isolate;
    width: var(--ficha);

    &:focus {
      outline: none;
    }
  }

  .tarjeta {
    border: var(--border);
    border-radius: 14px;
    overflow: hidden;
    background-color: var(--color-white);

    h3 {
      margin: 0;
      padding: 7px 6px;
      font-family: var(--font-bold);
      font-size: var(--letra-nombre, 0.95rem);
      line-height: 1.2;
      text-align: center;
    }
  }

  /* En blanco y negro hasta que se pasa por la ficha; ahí la foto recupera sus colores
     originales, porque el filtro se quita y no se le pone ningún tinte */
  .foto {
    aspect-ratio: 1;
    border-bottom: var(--border);
    background-color: var(--color-surface);
    filter: grayscale(1);
    transition: filter 300ms ease;

    img,
    svg {
      display: block;
      width: 100%;
      height: 100%;
    }

    img {
      object-fit: cover;
    }

    /* El espacio vacío va en azul, sin verde: el único verde de la ficha es el del correo */
    svg {
      fill: var(--color-primary);
    }
  }

  /* Pestaña pegada abajo de la tarjeta, un poco más angosta */
  .puesto {
    margin: 0 8px;
    padding: 5px 6px 6px;
    border-radius: 0 0 10px 10px;
    background-color: var(--color-primary);
    color: var(--color-white);
    font-size: var(--letra-puesto, 0.85rem);
    line-height: 1.2;
    text-align: center;
  }

  /* Pestaña del correo: está escondida detrás de la tarjeta y sale por la derecha.
     Se esconde con opacity y no con visibility para que el enlace siga alcanzándose
     con el teclado, que es lo que la abre */
  .correo {
    position: absolute;
    z-index: -1;
    top: 12px;
    /* Se encima 2px para que su borde se junte con el de la tarjeta */
    left: calc(100% - 2px);
    width: var(--correo);
    margin: 0;
    padding: 7px 8px 8px 10px;
    border: var(--border);
    border-left: 0;
    border-radius: 0 10px 10px 0;
    background-color: var(--color-mint);
    font-size: 0.75rem;
    line-height: 1.25;
    opacity: 0;
    translate: -100% 0;
    pointer-events: none;
    transition:
      translate 250ms ease,
      opacity 200ms ease;

    span {
      display: block;
      margin-bottom: 2px;
      font-family: var(--font-bold);
      font-size: 0.8rem;
    }

    a {
      color: inherit;
      overflow-wrap: anywhere;

      &:focus-visible {
        outline: var(--focus-ring);
        outline-offset: 2px;
      }
    }
  }

  .ficha:is(:hover, :focus-within) {
    /* Encima de las líneas y de las fichas vecinas mientras está abierta */
    z-index: 2;

    .foto {
      filter: none;
    }

    .correo {
      opacity: 1;
      translate: 0 0;
      pointer-events: auto;
    }
  }

  /* En celular no hay lugar a los lados, así que el correo sale encima de la foto y la
     cubre toda. El fondo es menta translúcido con la foto borrosa detrás: se nota que
     está sobre la foto, pero las orillas de la cara no se cruzan con las letras. Con el
     60% de menta el texto todavía cumple el contraste mínimo aunque la foto sea negra;
     con menos ya no */
  @media (max-width: 1023px) {
    .correo {
      /* Encima de la tarjeta, que es donde está la foto */
      z-index: 1;
      /* La foto es un cuadrado dentro del borde de 2px de la tarjeta; el correo ocupa
         ese mismo cuadrado, con las esquinas de arriba redondeadas como las de la tarjeta.
         Es 2px más bajo para no tapar la línea que separa la foto del nombre */
      top: 2px;
      left: 2px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      width: calc(var(--ficha) - 4px);
      height: calc(var(--ficha) - 6px);
      padding: 6px;
      border: 0;
      border-radius: 12px 12px 0 0;
      background-color: color-mix(in srgb, var(--color-mint) 60%, transparent);
      -webkit-backdrop-filter: blur(10px);
      backdrop-filter: blur(10px);
      font-size: 0.7rem;
      line-height: 1.2;
      text-align: center;
      /* Cubre la foto entera, así que solo aparece, sin moverse */
      translate: 0 0;

      span {
        margin-bottom: 0;
        font-size: 0.72rem;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .foto,
    .correo {
      transition: none;
    }
  }
</style>

---
import Carrusel from "./Carrusel.astro";
---

<section id="inicio" class="hero">
  <h1>VetCareHub, clínica veterinaria en Cuernavaca</h1>
  <small class="subtitulo">
    Consultas, vacunas, cirugía y estética para perros y gatos, todo en un mismo
    lugar en Tlaltenango.
  </small>

  <Carrusel />
</section>

<style>
  .hero {
    width: 100%;
    display: flex;
    align-items: center;
    flex-direction: column;

    h1 {
      margin: 14px 16px 0;
      font-family: var(--font-bold);
      font-size: 2.1rem;
      text-align: center;
    }

    .subtitulo {
      max-width: 60ch;
      margin: 12px auto 0;
      padding: 0 16px;
      font-size: 1rem;
      text-align: center;
      opacity: 0.75;
    }
  }
</style>

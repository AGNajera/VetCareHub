const listaServicios = Object.entries(catalogoServicios).map(([clave, datos]) => ({
  ...datos,
  trazos: iconos[clave as Servicio],
}));
---

<section id="servicios" class="section">
  <h2>Servicios y precios</h2>
  <p class="section-intro">
    Contamos con 20 servicios médicos, quirúrgicos, de diagnóstico y estética
    en un mismo lugar, con precios claros desde el inicio.
  </p>

  <ul class="servicios">
    {
      listaServicios.map(({ trazos, nombre, precio, texto }) => (
        <li>
          <div class="cabecera">
            <span class="icono">
              <svg
                class="icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                {trazos.map((d) => (
                  <path d={d} />
                ))}
              </svg>
            </span>
            <span class="precio">{pesos.format(precio)}</span>
          </div>
          <h3>{nombre}</h3>
          <p>{texto}</p>
        </li>
      ))
    }
  </ul>
</section>

<style>
  /* El fondo marino asoma por el gap de 2px y hace de borde compartido entre celdas,
     igual que los separadores del menú. Con 4, 2 o 1 columnas las 20 tarjetas siempre
     llenan filas completas sin dejar cuadros vacíos al final */
  .servicios {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
    border: var(--border);
    border-radius: 14px;
    overflow: hidden;
    background-color: var(--color-primary);

    li {
      position: relative;
      display: flex;
      flex-direction: column;
      padding: 22px;
      background-color: var(--color-white);
    }
  }

  .cabecera {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 10px;
  }

  .icono {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 52px;
    height: 52px;
    border: var(--border);
    border-radius: 50%;
    background-color: var(--color-mint);

    .icon {
      width: 28px;
      height: 28px;
    }
  }

  .precio {
    padding: 5px 11px;
    border: var(--border);
    border-radius: 999px;
    background-color: var(--color-mint);
    color: var(--color-primary);
    font-family: var(--font-bold);
    font-size: 0.98rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  h3 {
    margin: 16px 0 6px;
    font-family: var(--font-bold);
    font-size: 1.2rem;
  }

  li p {
    margin: 0;
    line-height: 1.5;
  }

  @media (max-width: 960px) {
    .servicios {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 540px) {
    .servicios {
      grid-template-columns: 1fr;
    }
  }
</style>

---
// Cada página puede pasar su título para que la pestaña diga en cuál estás,
// y su descripción, que es el texto que sale en los resultados de Google
const {
  titulo,
  descripcion = "Clínica veterinaria en Tlaltenango, Cuernavaca. Consultas, vacunas, cirugía, laboratorio y estética para perros y gatos en un mismo lugar.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={descripcion} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Las fuentes se piden desde el principio para que el texto no brinque cuando llegan.
         crossorigin es obligatorio en fuentes, sin él el navegador las descarga dos veces -->
    <link
      rel="preload"
      href="/SimplySans-Book.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/SimplySans-Bold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{titulo ? `${titulo} | VetCareHub` : "VetCareHub"}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "SimplySans-Book";
    src: url("/SimplySans-Book.woff2") format("woff2");
    font-display: swap;
  }

  @font-face {
    font-family: "SimplySans-Bold";
    src: url("/SimplySans-Bold.woff2") format("woff2");
    font-display: swap;
  }

  /* Variables globales: colores, fuentes y bordes que se repiten en todo el sitio */
  :root {
    --color-primary: #01215b;
    --color-accent: #3f8f7a;
    /* Menta de las ilustraciones del carrusel */
    --color-mint: #dff0ea;
    --color-white: #fff;
    --color-bg: oklch(100% 0% 68deg);
    --color-surface: oklch(97% 1% 89deg);
    --color-shadow: rgb(1 33 91 / 50%);

    /* Tipo de letra gratis convertido a woff2, porque es el estandar y el más optimizado
       https://fontlibrary.org/en/font/simply-sans */
    --font-body:
      "SimplySans-Book", system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", Roboto, Oxygen, Ubuntu, sans-serif;
    --font-bold: "SimplySans-Bold", system-ui, sans-serif;

    --border: 2px solid var(--color-primary);
    --focus-ring: 3px solid var(--color-accent);
    /* Alto del header en celular; el sidebar deja este espacio arriba para el botón */
    --header-height: 52px;
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }

  html {
    scroll-behavior: smooth;
    /* Evita que el header sticky tape los títulos al navegar con anclas */
    scroll-padding-top: 64px;
  }

  /* Secciones de contenido debajo del hero: mismo ancho, márgenes y títulos */
  .section {
    width: min(100%, 1080px);
    margin-inline: auto;
    padding: 56px 16px;

    h2 {
      margin: 0 0 12px;
      font-family: var(--font-bold);
      font-size: 1.8rem;
    }
  }

  .section-intro {
    max-width: 60ch;
    margin: 0 0 32px;
    font-size: 1.15rem;
    line-height: 1.55;
  }

  /* Animaciones de las ilustraciones que comparten el carrusel y la historia */
  /* Todas empiezan y terminan en la posición original (0%, 100%) para que al hacer hover
     el movimiento arranque suave y no brinque directo a un extremo */
  @keyframes menear {
    0%,
    100% {
      rotate: 0deg;
    }
    25% {
      rotate: -10deg;
    }
    75% {
      rotate: 10deg;
    }
  }

  @keyframes balancear {
    0%,
    100% {
      rotate: 0deg;
    }
    25% {
      rotate: -6deg;
    }
    75% {
      rotate: 6deg;
    }
  }

  @keyframes parpadear {
    0%,
    90%,
    100% {
      scale: 1 1;
    }
    95% {
      scale: 1 0.1;
    }
  }

  @keyframes latir {
    0%,
    100% {
      scale: 1;
    }
    50% {
      scale: 1.15;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>
